---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';

const navLinks = [
  { href: '/#notes', label: '灵光' },
  { href: '/#products', label: '奇遇' },
  { href: '/#projects', label: '项目' },
  { href: '/#references', label: '参考' },
  { href: '/#essays', label: '文章' },
  { href: '/#newsletter', label: '启发' },
  { href: '/#contact', label: '联系' },
];

const { title, date, description } = Astro.props;
// 浏览器标签页标题：默认在页面标题后加「 — Yishan」，页面已经带名字时可以传 docTitle 覆盖
const docTitle = Astro.props.docTitle ?? `${title} — Yishan`;
const dateStr = date
  ? new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<Base title={docTitle} description={description}>
  <SiteHeader links={navLinks} />

  <main class="wrap">
    <article class="article">
      <header class="article-head">
        <h1 class="display">{title}</h1>
        {dateStr && <p class="mono article-meta">{dateStr}</p>}
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="article-foot">
        <a class="arrow-link mono" href="/">返回首页 <span class="arrow">→</span></a>
      </footer>
    </article>
  </main>
</Base>

<style>
  .article {
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 0 80px;
  }
  .article-head {
    padding: 40px 0 0;
    margin-bottom: 48px;
  }
  h1 {
    font-size: clamp(28px, 4.5vw, 40px);
    font-weight: 600;
    line-height: 1.35;
  }
  .article-meta {
    margin-top: 14px;
  }
  .article-foot {
    margin-top: 80px;
  }
  .article-foot .arrow-link {
    color: var(--ink-2);
  }

  .prose {
    font-size: 16px;
    color: var(--ink);
  }
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--display);
    font-weight: 600;
    line-height: 1.4;
    margin: 2.2em 0 0.8em;
  }
  .prose :global(h1) { font-size: 26px; }
  .prose :global(h2) { font-size: 22px; }
  .prose :global(h3) { font-size: 19px; }
  .prose :global(h4) { font-size: 16px; }
  .prose :global(p) {
    margin: 0 0 1.2em;
    line-height: 1.9;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.25s ease;
  }
  .prose :global(a:hover) {
    color: var(--vermillion);
  }
  /* 正文里的强调不用斜体 */
  .prose :global(em) {
    font-style: normal;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2em auto;
  }
  .prose :global(blockquote) {
    margin: 1.8em 0;
    padding-left: 2em;
    color: var(--ink-2);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
    line-height: 1.85;
  }
  /* 分隔线只留空白 */
  .prose :global(hr) {
    border: none;
    margin: 3em 0;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
  }
  .prose :global(pre) {
    overflow-x: auto;
    margin: 0 0 1.2em;
  }
  .prose :global(table) {
    border-collapse: collapse;
    margin: 0 0 1.2em;
    width: 100%;
    font-size: 14px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 6px 24px 6px 0;
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .article {
      padding: 40px 0 64px;
    }
  }
</style>
