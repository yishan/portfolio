---
import Article from '../layouts/Article.astro';
import { resume } from '../data/resume.js';

---

<Article
  title={resume.name}
  description={`${resume.name} · ${resume.headline}`}
>
  <div class="resume">
    <p class="mono r-meta">
      <span>{resume.headline}</span>
      <a href={`mailto:${resume.email}`}>{resume.email}</a>
    </p>

    <h2 class="section-label r-label">个人优势</h2>
    <ul class="r-list">
      {resume.strengths.map((s) => <li><span class="mono r-mark">-</span>{s}</li>)}
    </ul>

    <h2 class="section-label r-label">工作经历</h2>
    {resume.work.map((w) => (
      <div class="r-entry">
        <p class="mono r-period">{w.period}</p>
        <h3 class="r-title">{w.org} <span class="r-role">{w.role}</span></h3>
        <ul class="r-list">
          {w.duties.map((d) => <li><span class="mono r-mark">-</span>{d}</li>)}
        </ul>
        {w.results && (
          <>
            <p class="mono r-sub">业绩</p>
            <ul class="r-list">
              {w.results.map((r) => <li><span class="mono r-mark">-</span>{r}</li>)}
            </ul>
          </>
        )}
      </div>
    ))}

    <h2 class="section-label r-label">项目经历</h2>
    {resume.projects.map((p) => (
      <div class="r-entry">
        <p class="mono r-period">{p.period}</p>
        <h3 class="r-title">{p.name} <span class="r-role">{p.role}</span></h3>
        {p.about && <p class="r-about">{p.about}</p>}
        {p.points && (
          <ul class="r-list">
            {p.points.map((x) => <li><span class="mono r-mark">-</span>{x}</li>)}
          </ul>
        )}
      </div>
    ))}

    <h2 class="section-label r-label">教育经历</h2>
    {resume.education.map((e) => (
      <div class="r-entry">
        <p class="mono r-period">{e.period}</p>
        <h3 class="r-title">{e.school} <span class="r-role">{e.degree}</span></h3>
      </div>
    ))}
  </div>
</Article>

<style>
  /* 纯文本简历：只用文字和留白，不加卡片、分割线与编号 */
  .resume {
    font-size: 15px;
  }
  .resume .r-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: -16px 0 0;
    color: var(--ink-2);
  }
  .resume .r-meta a {
    text-decoration: none;
  }
  .resume .r-meta a:hover {
    color: var(--vermillion);
  }
  .resume .r-label {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.75;
    margin: 64px 0 24px;
  }
  .resume .r-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .resume .r-list li {
    display: flex;
    gap: 1.5ch;
    margin: 0 0 6px;
    line-height: 1.8;
    color: var(--ink);
  }
  .resume .r-mark {
    flex-shrink: 0;
    line-height: inherit;
    padding-top: 0.15em;
    color: var(--ink-2);
  }
  .resume .r-entry {
    margin: 0 0 40px;
  }
  .resume .r-period {
    margin: 0 0 4px;
  }
  .resume .r-title {
    font-family: var(--mono);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 14px;
  }
  .resume .r-role {
    margin-left: 1ch;
    font-weight: 400;
    color: var(--ink-2);
  }
  .resume .r-about {
    color: var(--ink-2);
    line-height: 1.85;
    margin: 0 0 12px;
  }
  .resume .r-sub {
    margin: 14px 0 6px;
  }
</style>
