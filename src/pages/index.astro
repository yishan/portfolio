---
import Base from '../layouts/Base.astro';
import { profile, products, references, projects, lab, contacts } from '../data/content.js';
import { demos } from '../data/demos.js';
import { getNotes } from '../data/notes.js';
import { getEssays } from '../data/essays.js';
import { getNewsletter } from '../data/newsletter.js';
import Ascii from 'ascii.rest/astro';
import SiteHeader from '../components/SiteHeader.astro';

const { notes } = await getNotes();
const essays = await getEssays();
const newsletter = await getNewsletter();
// 灵光：没有脚本时显示最近三条；有脚本时访问时随机换成三条
const drawCount = 3;
const current = products[products.length - 1];
const timeline = [...products].reverse();
const fmtDate = (d) => d.slice(5).replace('-', '.');
const navLinks = [
  { href: '#notes', label: '灵光' },
  { href: '#products', label: '奇遇' },
  { href: '#projects', label: '项目' },
  ...(demos.length > 0 ? [{ href: '#lab', label: '试验' }] : []),
  { href: '#references', label: '参考' },
  { href: '#essays', label: '文章' },
  { href: '#newsletter', label: '启发' },
  { href: '#contact', label: '联系' },
];
---

<Base>
  <SiteHeader links={navLinks} />

  <main>
    <section class="cover" aria-label="封面">
      <canvas id="cover-rain" aria-hidden="true"></canvas>
      <div class="wrap">
        <div class="art-fit hero-name" style="--cols: 66">
          <Ascii piece="big-text" options={{ text: profile.name.toUpperCase() }} label={profile.name} />
        </div>
      </div>
      <a class="mono scroll-cue" href="#hero" id="scroll-cue" aria-label="向下滚动到正文">↓</a>
    </section>

    <section class="hero" id="hero">
      <div class="wrap hero-body">
        <div class="hero-text">
          <h1 class="display hello">你好，我是{profile.cnName}。</h1>
          <p class="hero-role">{profile.role}</p>
          <p class="epigraph">“{profile.epigraph}”</p>
          <div class="hero-intro">
            {profile.intro.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <div class="art-fit hero-art" style="--cols: 64">
          <Ascii piece="black-hole" fps={15} label="一个黑洞：吸积盘绕着中心旋转，光线被引力弯折" />
        </div>
      </div>
    </section>

    <section class="section" id="notes">
      <div class="wrap">
        <h2 class="section-label">灵光</h2>
        <ol class="draw-list" id="draw-list">
          {notes.slice(0, drawCount).map((n) => (
            <li class="draw-note">
              <a class="mono draw-date" href={`/notes#${n.id}`}><time datetime={n.date}>{n.date.replaceAll('-', '.')}</time></a>
              <div class="draw-body" set:html={n.body} />
            </li>
          ))}
        </ol>
        <a class="mono arrow-link more-link" href="/notes">全部 {notes.length} 条 <span class="arrow">→</span></a>
        <script is:inline type="application/json" id="notes-data" set:html={JSON.stringify(notes.map(({ id, date, body }) => ({ id, date, body }))).replaceAll('<', '\\u003c')} />
      </div>
    </section>

    <section class="section" id="products">
      <div class="wrap">
        <h2 class="section-label">产品奇遇</h2>
        <p class="section-note">每年我会总结一份当年使用的互联网产品与服务。</p>
        <ul class="years">
          {timeline.map((p) => (
            <li>
              <a class="mono year" class:list={{ current: p.year === current.year }} href={p.href}>{p.year}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="wrap">
        <h2 class="section-label">兴趣项目</h2>
        <p class="section-note">{projects.about}</p>
        <div class="block-grid">
          {projects.items.map((p) => (
            <a class="block" href={p.href}>
              <p class="display block-title">{p.name} <span class="arrow" aria-hidden="true">↗</span></p>
              <p class="block-desc">{p.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {demos.length > 0 && (
      <section class="section" id="lab">
        <div class="wrap">
          <h2 class="section-label">随手试验</h2>
          <p class="section-note">{lab.about}</p>
          <ul class="lab-grid">
            {demos.slice(0, lab.limit).map((d) => (
              <li>
                <a class="lab-card" href={d.url}>
                  <div class="lab-thumb">
                    {d.thumb && <img class:list={{ 'thumb-light': d.thumbDark }} src={d.thumb} alt="" loading="lazy" decoding="async" />}
                    {d.thumb && d.thumbDark && <img class="thumb-dark" src={d.thumbDark} alt="" loading="lazy" decoding="async" />}
                  </div>
                  <p class="display lab-title">{d.title}</p>
                  <p class="mono lab-date"><time class="rel-date" datetime={d.date}>{fmtDate(d.date)}</time></p>
                </a>
              </li>
            ))}
          </ul>
          <a class="mono arrow-link more-link" href={lab.href}>全部 {demos.length} 个 <span class="arrow">→</span></a>
        </div>
      </section>
    )}

    <section class="section" id="references">
      <div class="wrap">
        <h2 class="section-label">参考文本</h2>
        <div class="block-grid">
          {references.map((r) => (
            <a class="block" href={r.href}>
              <p class="display block-title">{r.title} <span class="arrow" aria-hidden="true">→</span></p>
              <p class="block-desc">{r.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="essays">
      <div class="wrap" data-reveal>
        <h2 class="section-label">但说无妨</h2>
        <p class="section-note">{essays.about}</p>
        {essays.groups.map((g) => (
          <div class="essay-group">
            <h3 class="mono essay-year">{g.year}</h3>
            <ul class="essay-list" id={`essay-list-${g.year}`}>
              {g.items.map((e, idx) => (
                <li class:list={{ 'list-extra': idx >= 5 }} style={idx >= 5 ? `--i: ${idx - 5}` : undefined}>
                  <a
                    class="row"
                    href={e.href}
                    {...(e.external && { target: '_blank', rel: 'noopener' })}
                  >
                    {e.title}{e.external && <span class="arrow" aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              ))}
            </ul>
            {g.items.length > 5 && (
              <button
                class="mono list-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`essay-list-${g.year}`}
                data-count={g.items.length - 5}
                data-unit="篇"
              >展开其余 {g.items.length - 5} 篇</button>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="newsletter">
      <div class="wrap" data-reveal>
        <h2 class="section-label">有所启发</h2>
        <p class="section-note">
          {newsletter.about}
          <a class="arrow-link subscribe" href={newsletter.subscribe}>欢迎订阅 <span class="arrow">→</span></a>
        </p>
        <ul class="issue-list" id="issue-list">
          {newsletter.issues.map((i, idx) => (
            <li class:list={{ 'list-extra': idx >= 5 }} style={idx >= 5 ? `--i: ${idx - 5}` : undefined}>
              <a class="row" href={i.href}>{i.title}</a>
            </li>
          ))}
        </ul>
        {newsletter.issues.length > 5 && (
          <button
            class="mono list-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="issue-list"
            data-count={newsletter.issues.length - 5}
            data-unit="期"
          >展开其余 {newsletter.issues.length - 5} 期</button>
        )}
        <div class="fig" data-fig="typewriter"></div>
      </div>
    </section>

  </main>

  <footer class="footer" id="contact">
    <div class="wrap">
      <h2 class="section-label">在这些地方找到我</h2>
      <ul class="contact-list">
        {contacts.map((c) => (
          <li class="contact-item">
            <span class="mono contact-label">{c.label}</span>
            {c.href ? (
              <a class="arrow-link contact-value" href={c.href}>{c.value} <span class="arrow">↗</span></a>
            ) : (
              <span class="contact-value">{c.value}</span>
            )}
          </li>
        ))}
      </ul>
      <p class="mono footer-links">
        <span>© {new Date().getFullYear()} Yishan · {profile.motto}</span>
        <a href="/resume">Resume</a>
        <a href="/read">在读</a>
        <a href="/listen">在听</a>
        <a href="/licenses.txt">第三方许可</a>
      </p>
    </div>
  </footer>
</Base>

<style>
  /* 封面：占满首屏，只放大字和一行字符雨；底部一个向下的箭头 */
  .cover {
    position: relative;
    min-height: calc(100svh - 56px);
    display: flex;
    align-items: center;
    padding: 48px 0 120px;
  }
  .cover > .wrap {
    position: relative;
    width: 100%;
  }
  #cover-rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  .scroll-cue {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    padding: 6px 10px;
    font-size: 16px;
    transition: color 0.25s ease;
  }
  .scroll-cue:hover {
    color: var(--vermillion);
  }

  /* 字符作品按列数铺满容器：字号 = 容器宽 / (列数 × 字宽) */
  .art-fit {
    container-type: inline-size;
    margin: 0;
  }
  .art-fit :global(ascii-art) {
    display: block;
    font-family: var(--mono);
    font-size: min(var(--max-px, 26px), calc(100cqw / (var(--cols) * 0.61)));
    line-height: 1;
    color: var(--ink);
  }
  .art-fit :global(pre) {
    margin: 0;
    font: inherit;
  }

  .hero {
    padding: 96px 0 72px;
  }
  /* 左边问候与介绍，右边黑洞；窄屏时黑洞落到介绍下面 */
  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .hero-art {
    --max-px: 12px;
  }
  .hero-art :global(ascii-art) {
    line-height: 1.15;
  }
  .hello {
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.5;
  }
  .hero-role {
    margin-top: 4px;
    color: var(--ink-2);
  }
  .epigraph {
    margin-top: 40px;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.7;
  }
  .hero-intro {
    margin-top: 24px;
    display: grid;
    gap: 12px;
    color: var(--ink-2);
    font-size: 15px;
  }

  /* 唯一留下的线稿：有所启发末尾的打字机，只用一种线色 */
  .fig {
    width: 195px;
    margin: 48px 0 0 auto;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .fig :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .fig :global(:is(polygon, polyline, line, circle)) {
    fill: var(--paper);
    stroke: var(--ink-2);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .fig :global(.fo) {
    stroke: var(--paper);
    stroke-width: 0.6;
  }
  .fig :global(.nf) { fill: none; }
  .fig :global(.accent) { stroke: var(--vermillion); }
  .fig :global(.fo.accent) { fill: var(--vermillion); }
  @media (max-width: 720px) {
    .fig { display: none; }
  }

  /* 文章与启发列表：进入视野后逐条浮现，每条 0.6 秒。
     只有脚本加上 .rv 才隐藏，没有脚本或减弱动态时内容照常显示 */
  .rv :is(.essay-year, .essay-list > li:not(.list-extra), .issue-list > li:not(.list-extra)) {
    opacity: 0;
    translate: 0 4px;
  }
  .rv.rv-in :is(.essay-year, .essay-list > li:not(.list-extra), .issue-list > li:not(.list-extra)) {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
      translate 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--d, 0s);
  }

  .section-note {
    max-width: 620px;
    color: var(--ink-2);
    font-size: 15px;
    margin: -16px 0 36px;
  }
  .subscribe {
    margin-left: 10px;
    color: var(--ink);
  }
  .more-link {
    display: inline-flex;
    margin-top: 28px;
  }

  /* 灵光：三条短记，左边日期，右边全文 */
  .draw-list {
    list-style: none;
    padding: 0;
    max-width: 820px;
    display: grid;
    gap: 28px;
  }
  .draw-list :global(.draw-note) {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 24px;
  }
  .draw-list :global(.draw-date) {
    padding-top: 3px;
    font-size: 13px;
    transition: color 0.25s ease;
  }
  .draw-list :global(.draw-date:hover) {
    color: var(--vermillion);
  }
  .draw-list :global(.draw-body) {
    font-size: 15px;
    line-height: 1.9;
    min-width: 0;
  }
  .draw-list :global(.draw-body p + p) {
    margin-top: 0.7em;
  }
  .draw-list :global(.draw-body a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .draw-list :global(.draw-body a:hover) {
    color: var(--vermillion);
  }
  .draw-list :global(.draw-note) {
    transition:
      opacity 1.6s cubic-bezier(0.25, 0.1, 0.25, 1),
      translate 1.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .draw-list.veiled :global(.draw-note) {
    opacity: 0;
    translate: 0 4px;
  }
  @media (max-width: 720px) {
    .draw-list :global(.draw-note) {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  /* 产品奇遇：一行年份，最近一年用墨色，其余用浅一级 */
  .years {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }
  .year {
    font-size: 15px;
    transition: color 0.25s ease;
  }
  .year.current {
    color: var(--ink);
  }
  .year:hover {
    color: var(--vermillion);
  }

  /* 项目与参考：没有边框的文字块，靠网格间距分组 */
  .block-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 36px 48px;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .block-title {
    font-size: 16px;
    transition: color 0.25s ease;
  }
  .block-title .arrow {
    display: inline-block;
    color: var(--ink-2);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.25s ease;
  }
  .block-desc {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.7;
  }
  .block:hover .block-title,
  .block:hover .block-title .arrow {
    color: var(--vermillion);
  }
  .block:hover .block-title .arrow {
    transform: translateX(3px);
  }

  .lab-grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px 24px;
  }
  @media (max-width: 860px) {
    .lab-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .lab-grid { grid-template-columns: 1fr; }
  }
  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .lab-thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .lab-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: grayscale(1);
    transition: filter 0.3s ease;
  }
  .lab-card:hover .lab-thumb img {
    filter: none;
  }
  /* 亮/暗两张截图按当前主题只显示一张；懒加载的图片在 display:none 时不会下载 */
  .lab-thumb .thumb-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .lab-thumb .thumb-light { display: none; }
    :global(:root:not([data-theme='light'])) .lab-thumb .thumb-dark { display: block; }
  }
  :global(:root[data-theme='dark']) .lab-thumb .thumb-light { display: none; }
  :global(:root[data-theme='dark']) .lab-thumb .thumb-dark { display: block; }
  .lab-title {
    font-size: 14px;
    line-height: 1.45;
    transition: color 0.25s ease;
  }
  .lab-date {
    font-size: 12px;
  }
  .lab-card:hover .lab-title {
    color: var(--vermillion);
  }

  /* 文章与启发：只有标题，悬停变红 */
  .essay-group + .essay-group {
    margin-top: 40px;
  }
  .essay-year {
    font-size: 13px;
    margin-bottom: 12px;
  }
  .essay-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0 56px;
  }
  .issue-list {
    list-style: none;
    padding: 0;
  }
  .row {
    display: block;
    padding: 6px 0;
    font-size: 15px;
    transition: color 0.25s ease;
  }
  .row .arrow {
    color: var(--ink-2);
  }
  .row:hover,
  .row:hover .arrow {
    color: var(--vermillion);
  }

  .list-extra {
    display: none;
  }
  .expanded .list-extra {
    display: block;
    animation: list-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 30ms);
  }
  @keyframes list-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .list-toggle {
    margin-top: 16px;
    padding: 6px 0;
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.25s ease;
  }
  .list-toggle:hover {
    color: var(--vermillion);
  }

  .footer {
    padding: 72px 0 48px;
  }
  .contact-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px 32px;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .contact-label {
    font-size: 12px;
  }
  .contact-value {
    font-size: 15px;
  }
  .footer-links {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .footer-links a {
    transition: color 0.25s ease;
  }
  .footer-links a:hover {
    color: var(--vermillion);
  }

  @media (max-width: 720px) {
    .hero {
      padding: 56px 0 48px;
    }
    .hero-body {
      grid-template-columns: 1fr;
    }
    .cover {
      padding-bottom: 110px;
    }
    .section {
      padding: 56px 0;
    }
  }
</style>

<script>
  import { initMatrixField } from '../scripts/matrix-field.js';
  import { mount } from '../scripts/figures/engine.js';
  import { typewriter } from '../scripts/figures/typewriter.js';

  initMatrixField(document.getElementById('cover-rain'));

  // 封面：点提示或在封面上按回车，平滑滚到正文（不改地址栏）
  const toContent = () =>
    document.getElementById('hero').scrollIntoView({
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
    });
  document.getElementById('scroll-cue').addEventListener('click', (e) => {
    e.preventDefault();
    toContent();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.target !== document.body) return;
    if (scrollY > innerHeight / 2) return;
    e.preventDefault();
    toContent();
  });

  // 文章与启发：列表进入视野后逐条浮现，每条错开 0.12 秒
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = ':is(.essay-year, .essay-list > li:not(.list-extra), .issue-list > li:not(.list-extra))';
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach(({ isIntersecting, target }) => {
          if (!isIntersecting) return;
          io.unobserve(target);
          target.classList.add('rv-in');
        });
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('[data-reveal]').forEach((wrap) => {
      wrap.querySelectorAll(items).forEach((el, i) => el.style.setProperty('--d', `${Math.min(i, 12) * 0.12}s`));
      wrap.classList.add('rv');
      io.observe(wrap);
    });
  }

  // 打字机线稿：指针在整个区块里移动都算"靠近"
  document.querySelectorAll('.fig').forEach((el) => mount(el, typewriter(), { trigger: el.closest('section') }));


  // 灵光：每次访问随机抽三条短记，进入视野后依次慢慢浮现
  {
    const list = document.getElementById('draw-list');
    const pool = JSON.parse(document.getElementById('notes-data').textContent);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COUNT = 3;
    const draw = () => {
      const a = [...pool];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a.slice(0, COUNT);
    };

    const render = (items) => {
      list.innerHTML = '';
      items.forEach((n, i) => {
        const li = document.createElement('li');
        li.className = 'draw-note';
        if (!reduce) li.style.transitionDelay = `${i * 0.45}s`;
        const a = document.createElement('a');
        a.className = 'mono draw-date';
        a.href = `/notes#${n.id}`;
        a.innerHTML = `<time datetime="${n.date}">${n.date.replaceAll('-', '.')}</time>`;
        const body = document.createElement('div');
        body.className = 'draw-body';
        body.innerHTML = n.body;
        li.append(a, body);
        list.append(li);
      });
    };
    const reveal = () => {
      list.offsetHeight; // 先让「隐去」状态生效，过渡才会发生
      list.classList.remove('veiled');
    };

    list.classList.add('veiled');
    render(draw());
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        reveal();
      },
      { threshold: 0.25 },
    );
    io.observe(list);
  }

  // 构建时只写入日期，访问时换成相对时间，避免两次构建之间“2 天前”过期
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  document.querySelectorAll('.rel-date').forEach((el) => {
    const [y, m, d] = el.getAttribute('datetime').split('-').map(Number);
    const days = Math.round((today - new Date(y, m - 1, d)) / 86400000);
    if (days === 0) el.textContent = '今天';
    else if (days === 1) el.textContent = '昨天';
    else if (days > 1 && days < 7) el.textContent = `${days} 天前`;
  });

  document.querySelectorAll('.list-toggle').forEach((btn) => {
    const list = document.getElementById(btn.getAttribute('aria-controls'));
    btn.addEventListener('click', () => {
      const expanded = list.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(expanded));
      btn.textContent = expanded
        ? '收起'
        : `展开其余 ${btn.dataset.count} ${btn.dataset.unit}`;
      if (!expanded) list.scrollIntoView({ block: 'nearest' });
    });
  });
</script>
