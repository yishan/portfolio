---
import Base from '../layouts/Base.astro';
import { profile, products, newsletter, essays, references, projects, lab, contacts } from '../data/content.js';
import { demos } from '../data/demos.js';
import Ascii from 'ascii.rest/astro';

const current = products[products.length - 1];
const timeline = [...products].reverse();
const fmtDate = (d) => d.slice(5).replace('-', '.');
// 随手试验区块在没有数据时隐藏，之后的区块编号随之前移
const no = (n) => String(demos.length > 0 ? n : n - 1).padStart(2, '0');
---

<Base>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="mono brand scramble">YISHAN.LI</a>
      <nav class="mono site-nav" aria-label="主导航">
        <a href="#products" class="scramble">奇遇</a>
        <a href="#projects" class="scramble">项目</a>
        {demos.length > 0 && <a href="#lab" class="scramble">试验</a>}
        <a href="#references" class="scramble">参考</a>
        <a href="#newsletter" class="scramble">启发</a>
        <a href="#essays" class="scramble">文章</a>
        <a href="#contact" class="scramble">联系</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" id="hero">
      <div class="wrap">
        <p class="mono hero-kicker">PRODUCT · UX · DATA — SINCE {profile.since}</p>
        <div class="art-fit hero-name" style="--cols: 66">
          <Ascii piece="big-text" options={{ text: profile.name.toUpperCase() }} label={profile.name} />
        </div>
        <div class="hero-body">
          <div class="hero-text">
            <h1 class="display hello"><span class="prompt" aria-hidden="true">$</span> 你好，我是{profile.cnName}。<span class="cursor" aria-hidden="true"></span></h1>
            <p class="hero-role">{profile.role}</p>
            <p class="epigraph">“{profile.epigraph}”</p>
            <div class="hero-intro">
              {profile.intro.map((p) => <p>{p}</p>)}
            </div>
            <p class="mono motto"># {profile.motto}</p>
          </div>
          <figure class="art-fit hero-art" style="--cols: 64">
            <Ascii piece="black-hole" fps={15} label="一个黑洞：吸积盘绕着中心旋转，光线被引力弯折" />
            <figcaption class="mono">fig. 1 — mass &amp; pull · ascii.rest</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="products">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">01</span> 产品奇遇 — REVIEW</h2>
        <div class="fig" data-fig="annual"></div>
        <p class="section-note">每年我会总结一份当年使用的互联网产品与服务。</p>
        <div class="timeline" role="list">
          <div class="timeline-rail" aria-hidden="true"></div>
          {timeline.map((p) => (
            <a class="timeline-node" class:list={{ current: p.year === current.year }} href={p.href} role="listitem">
              <span class="node-dot" aria-hidden="true"></span>
              <span class="mono node-year">{p.year}</span>
              {p.year === current.year && <span class="mono node-tag">最近</span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">02</span> 兴趣项目 — SIDE PROJECTS</h2>
        <p class="section-note">{projects.about}</p>
        <div class="project-grid">
          {projects.items.map((p) => (
            <a class="project-card" href={p.href}>
              <span class="tick tick-tl" aria-hidden="true">+</span>
              <span class="tick tick-tr" aria-hidden="true">+</span>
              <span class="tick tick-bl" aria-hidden="true">+</span>
              <span class="tick tick-br" aria-hidden="true">+</span>
              <p class="mono project-domain">{p.domain} <span class="project-arrow" aria-hidden="true">↗</span></p>
              <p class="display project-name">{p.name}</p>
              <p class="project-desc">{p.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {demos.length > 0 && (
      <section class="section" id="lab">
        <div class="wrap">
          <h2 class="section-label"><span class="index-no">03</span> 随手试验 — EXPERIMENTS</h2>
          <div class="fig" data-fig="beaker"></div>
          <p class="section-note">{lab.about}</p>
          <ul class="lab-grid">
            {demos.slice(0, lab.limit).map((d) => (
              <li>
                <a class="lab-card" href={d.url}>
                  <div class="lab-thumb">
                    {d.thumb && <img src={d.thumb} alt="" loading="lazy" decoding="async" />}
                  </div>
                  <p class="mono lab-date">
                    <time class="rel-date" datetime={d.date}>{fmtDate(d.date)}</time>
                    <span class="lab-arrow" aria-hidden="true">↗</span>
                  </p>
                  <p class="display lab-title">{d.title}</p>
                </a>
              </li>
            ))}
          </ul>
          <a class="mono arrow-link lab-all" href={lab.href}>
            全部 {demos.length} 个 demo · {lab.domain} <span class="arrow">→</span>
          </a>
        </div>
      </section>
    )}

    <section class="section" id="references">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">{no(4)}</span> 参考文本 — REFERENCE</h2>
        <div class="ref-grid">
          {references.map((r) => (
            <a class="ref-card" href={r.href}>
              <span class="tick tick-tl" aria-hidden="true">+</span>
              <span class="tick tick-tr" aria-hidden="true">+</span>
              <span class="tick tick-bl" aria-hidden="true">+</span>
              <span class="tick tick-br" aria-hidden="true">+</span>
              <p class="mono ref-label">{r.label}</p>
              <p class="display ref-title">{r.title}</p>
              <p class="ref-desc">{r.desc}</p>
              <span class="mono ref-go">阅读 <span class="arrow">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="newsletter">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">{no(5)}</span> 有所启发 — NEWSLETTER</h2>
        <p class="section-note">
          {newsletter.about}
          <a class="arrow-link subscribe" href={newsletter.subscribe}>欢迎订阅 <span class="arrow">→</span></a>
        </p>
        <ul class="issue-list" id="issue-list">
          {newsletter.issues.map((i, idx) => (
            <li class:list={{ 'list-extra': idx >= 5 }} style={idx >= 5 ? `--i: ${idx - 5}` : undefined}>
              <a class="issue-row" href={i.href}>
                <span class="mono issue-no">#{i.no}</span>
                <span class="issue-title">{i.title}</span>
                <span class="mono issue-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        {newsletter.issues.length > 5 && (
          <button
            class="mono list-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="issue-list"
            data-count={newsletter.issues.length - 5}
            data-unit="期"
          >
            <span class="toggle-plus" aria-hidden="true">+</span>
            <span class="toggle-text">展开其余 {newsletter.issues.length - 5} 期</span>
          </button>
        )}
      </div>
    </section>

    <section class="section" id="essays">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">{no(6)}</span> 但说无妨 — ESSAYS</h2>
        <p class="section-note">{essays.about}</p>
        {essays.groups.map((g) => (
          <div class="essay-group">
            <h3 class="mono essay-year">{g.year} →</h3>
            <ul class="essay-list" id={`essay-list-${g.year}`}>
              {g.items.map((e, idx) => (
                <li class:list={{ 'list-extra': idx >= 5 }} style={idx >= 5 ? `--i: ${idx - 5}` : undefined}>
                  <a class="essay-row" href={e.href}>
                    <span class="essay-title">{e.title}</span>
                    <span class="leader" aria-hidden="true"></span>
                    <span class="mono essay-no">{e.no}</span>
                  </a>
                </li>
              ))}
            </ul>
            {g.items.length > 5 && (
              <button
                class="mono list-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`essay-list-${g.year}`}
                data-count={g.items.length - 5}
                data-unit="篇"
              >
                <span class="toggle-plus" aria-hidden="true">+</span>
                <span class="toggle-text">展开其余 {g.items.length - 5} 篇</span>
              </button>
            )}
          </div>
        ))}
        <div class="fig fig-end" data-fig="typewriter"></div>
      </div>
    </section>

  </main>

  <footer class="footer" id="contact">
    <canvas id="ascii-field" aria-hidden="true"></canvas>
    <div class="wrap">
      <h2 class="section-label"><span class="index-no">{no(7)}</span> 在这些地方找到我 — FIND ME</h2>
      <ul class="contact-list">
        {contacts.map((c) => (
          <li class="contact-item">
            <span class="mono contact-label">{c.label}</span>
            {c.href ? (
              <a class="arrow-link contact-value" href={c.href}>{c.value} <span class="arrow">↗</span></a>
            ) : (
              <span class="contact-value">{c.value}</span>
            )}
          </li>
        ))}
      </ul>
      <p class="mono footer-motto">© {new Date().getFullYear()} Yishan · {profile.motto} · <a class="licenses" href="/licenses.txt">第三方许可</a></p>
    </div>
  </footer>
</Base>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 56px;
  }
  .brand {
    color: var(--ink);
    font-weight: 500;
  }
  .site-nav {
    display: flex;
    gap: 28px;
  }
  .site-nav a {
    color: var(--ink-2);
    transition: color 0.25s ease;
    display: inline-block;
  }
  .site-nav a:hover {
    color: var(--vermillion);
  }

  .hero {
    position: relative;
    padding: 56px 0 80px;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-kicker {
    margin-bottom: 18px;
  }
  /* 字符作品按列数铺满容器：字号 = 容器宽 / (列数 × 字宽) */
  .art-fit {
    container-type: inline-size;
    margin: 0;
  }
  .art-fit :global(ascii-art) {
    display: block;
    font-family: var(--mono);
    font-size: min(var(--max-px, 26px), calc(100cqw / (var(--cols) * 0.61)));
    line-height: 1.15;
    color: var(--ink);
  }
  .art-fit :global(pre) {
    margin: 0;
    font: inherit;
  }
  .hero-name :global(ascii-art) {
    color: var(--ink);
    line-height: 1;
  }
  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    margin-top: 40px;
    align-items: start;
  }
  .hello {
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.5;
  }
  .prompt {
    color: var(--vermillion);
    margin-right: 0.4ch;
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.3ch;
    vertical-align: -0.15em;
    background: var(--vermillion);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .hero-role {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--vermillion);
    margin-top: 6px;
    letter-spacing: 0.12em;
  }
  .epigraph {
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink);
    margin-top: 28px;
    padding-left: 2ch;
    border-left: 2px solid var(--vermillion);
  }
  .hero-intro {
    margin-top: 24px;
    display: grid;
    gap: 12px;
    color: var(--ink-2);
    font-size: 14px;
  }
  .motto {
    margin-top: 24px;
    color: var(--ink-2);
  }
  .hero-art {
    --max-px: 12px;
    padding: 8px;
    border: 1px dashed var(--hairline-strong);
  }
  .hero-art figcaption {
    margin-top: 8px;
    font-size: 11px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }

  /* 自绘等距线稿：浮在区块说明右侧；线宽与配色对齐 Hairline 的做法，颜色取站点变量 */
  .fig {
    float: right;
    width: var(--fig-w, 195px);
    margin: -16px 0 16px 32px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    --fg-plate: var(--paper);
    --fg-hi: var(--ink);
    --fg-edge: color-mix(in srgb, var(--ink) 55%, transparent);
    --fg-mid: color-mix(in srgb, var(--ink) 32%, transparent);
    --fg-lo: color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .fig :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .fig :global(:is(polygon, polyline, line, circle)) {
    fill: var(--fg-plate);
    stroke: var(--fg-mid);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .fig :global(.fo) {
    stroke: var(--fg-plate);
    stroke-width: 0.6;
  }
  .fig :global(.nf) { fill: none; }
  .fig :global(.sil) { stroke: var(--fg-edge); }
  .fig :global(.lo) { stroke: var(--fg-lo); }
  .fig :global(.hi) { stroke: var(--fg-hi); }
  .fig :global(.accent) { stroke: var(--vermillion); }
  .fig :global(.fo.accent) { fill: var(--vermillion); }
  /* 放在区块末尾、不与列表并排的图形：右对齐占一行 */
  .fig-end {
    float: none;
    margin: 8px 0 0 auto;
  }
  .timeline,
  .project-grid,
  .lab-grid,
  .issue-list {
    clear: both;
  }
  @media (max-width: 720px) {
    .fig { display: none; }
  }

  .section-note {
    max-width: 620px;
    color: var(--ink-2);
    font-size: 15px;
    margin: -16px 0 44px;
  }
  .subscribe {
    margin-left: 10px;
    color: var(--ink);
    border-bottom: 1px dotted var(--hairline-strong);
    padding-bottom: 1px;
  }

  .timeline {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding: 8px 2% 0;
  }
  .timeline-rail {
    position: absolute;
    top: 8px;
    left: 3%;
    right: 3%;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1;
    color: var(--ink-3);
  }
  .timeline-rail::before {
    content: '──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────';
  }
  .timeline-node {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 0 10px;
  }
  .node-dot {
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1;
    padding: 0 4px;
    background: var(--paper);
    color: var(--ink-3);
  }
  .node-dot::before {
    content: '[ ]';
  }
  .timeline-node.current .node-dot::before {
    content: '[*]';
  }
  .node-year {
    font-size: 14px;
    color: var(--ink-2);
    transition: color 0.25s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .node-tag {
    position: absolute;
    top: -26px;
    font-size: 11px;
    color: var(--vermillion);
    letter-spacing: 0.14em;
  }
  .timeline-node.current .node-dot {
    color: var(--vermillion);
  }
  .timeline-node.current .node-year {
    color: var(--ink);
    font-weight: 500;
  }
  .timeline-node:hover .node-dot {
    color: var(--vermillion);
  }
  .timeline-node:hover .node-dot::before {
    content: '[x]';
  }
  .timeline-node:hover .node-year {
    color: var(--vermillion);
    transform: translateY(3px);
  }

  .issue-list {
    list-style: none;
    padding: 0;
  }
  .issue-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 12px 4px;
    border-bottom: 1px dashed var(--hairline-strong);
    padding-left: 8px;
    padding-right: 8px;
  }
  .issue-no {
    color: var(--ink-3);
    flex-shrink: 0;
    transition: color 0.25s ease;
  }
  .issue-title {
    flex: 1;
    font-size: 15px;
    color: var(--ink);
  }
  .issue-arrow {
    color: var(--ink-3);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.25s ease;
  }
  .issue-row::before {
    content: '>';
    font-family: var(--mono);
    width: 0;
    overflow: hidden;
    color: var(--vermillion);
    transition: width 0.15s steps(2);
  }
  .issue-row:hover {
    background: var(--ink);
  }
  .issue-row:hover::before {
    width: 1ch;
  }
  .issue-row:hover .issue-title {
    color: var(--paper);
  }
  .issue-row:hover .issue-no {
    color: var(--vermillion);
  }
  .issue-row:hover .issue-arrow {
    color: var(--vermillion);
    transform: translateX(5px);
  }

  .essay-group {
    margin-bottom: 40px;
  }
  .essay-year {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
    margin-bottom: 18px;
    letter-spacing: 0.14em;
  }
  .essay-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 4px 56px;
  }
  .essay-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 0;
    font-size: 14px;
    color: var(--ink-2);
    position: relative;
  }
  .essay-row .essay-title {
    transition: color 0.25s ease;
  }
  .leader {
    flex: 1;
    min-width: 2ch;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-3);
  }
  .leader::before {
    content: '. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .';
  }
  .essay-no {
    color: var(--ink-3);
    font-size: 11px;
    transition: color 0.25s ease;
  }
  .essay-row:hover .essay-title {
    color: var(--vermillion);
  }
  .essay-row:hover .essay-no {
    color: var(--vermillion);
  }
  .essay-row:hover .leader {
    color: var(--vermillion);
  }

  .list-extra {
    display: none;
  }
  .expanded .list-extra {
    display: block;
    animation: list-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    animation-delay: calc(var(--i) * 30ms);
  }
  @keyframes list-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .list-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    padding: 6px 0;
    background: none;
    border: none;
    border-bottom: 1px dotted var(--hairline-strong);
    cursor: pointer;
    color: var(--ink-2);
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .toggle-plus::before { content: '['; }
  .toggle-plus::after { content: ']'; }
  .toggle-plus {
    display: inline-block;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1;
    color: var(--ink-3);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.25s ease;
  }
  .list-toggle:hover {
    color: var(--vermillion);
    border-bottom-color: var(--vermillion);
  }
  .list-toggle:hover .toggle-plus {
    color: var(--vermillion);
  }
  .expanded + .list-toggle .toggle-plus {
    font-size: 0;
  }
  .expanded + .list-toggle .toggle-plus::before {
    content: '[-]';
    font-size: 14px;
  }

  .ref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .ref-card {
    position: relative;
    border: 1px dashed var(--hairline-strong);
    background-clip: padding-box;
    padding: 26px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background-color 0.12s steps(2), border-color 0.12s steps(2);
  }
  .tick {
    position: absolute;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1;
    transition: color 0.3s ease;
  }
  .tick-tl { top: -7px; left: -5px; }
  .tick-tr { top: -7px; right: -5px; }
  .tick-bl { bottom: -7px; left: -5px; }
  .tick-br { bottom: -7px; right: -5px; }
  .ref-label {
    letter-spacing: 0.16em;
  }
  .ref-title {
    font-size: 16px;
  }
  .ref-desc {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.7;
    flex: 1;
  }
  .ref-go {
    color: var(--ink-3);
    margin-top: 8px;
    transition: color 0.25s ease;
  }
  .ref-go .arrow {
