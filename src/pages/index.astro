</style>

<script>
  import { initScramble } from '../scripts/interactions.js';
  import { initAsciiField } from '../scripts/ascii-field.js';
  import { initMatrixField } from '../scripts/matrix-field.js';
  import { mount } from '../scripts/figures/engine.js';
  import { annual } from '../scripts/figures/annual.js';
  import { beaker } from '../scripts/figures/beaker.js';
  import { typewriter } from '../scripts/figures/typewriter.js';
  import { prism } from '../scripts/figures/prism.js';

  initScramble(document.querySelectorAll('.scramble'));
  initMatrixField(document.getElementById('cover-rain'));

  // 封面：点提示或在封面上按回车，平滑滚到正文（不改地址栏）
  const toContent = () =>
    document.getElementById('hero').scrollIntoView({
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
    });
  document.getElementById('scroll-cue').addEventListener('click', (e) => {
    e.preventDefault();
    toContent();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' || e.target !== document.body) return;
    if (scrollY > innerHeight / 2) return;
    e.preventDefault();
    toContent();
  });
  initAsciiField(document.getElementById('ascii-field'));

  // 文章与启发：列表进入视野后逐条浮现，每条错开 0.12 秒
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = ':is(.essay-year, .essay-list > li:not(.list-extra), .issue-list > li:not(.list-extra))';
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach(({ isIntersecting, target }) => {
          if (!isIntersecting) return;
          io.unobserve(target);
          target.classList.add('rv-in');
        });
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('[data-reveal]').forEach((wrap) => {
      wrap.querySelectorAll(items).forEach((el, i) => el.style.setProperty('--d', `${Math.min(i, 12) * 0.12}s`));
      wrap.classList.add('rv');
      io.observe(wrap);
    });
  }

  // 每个区块的线稿图形：指针在整个区块里移动都算"靠近"
  const figures = { annual, beaker, typewriter, prism };
  document.querySelectorAll('.fig').forEach((el) => {
    const make = figures[el.dataset.fig];
    if (make) mount(el, make(), { trigger: el.closest('section, footer') });
  });


  // 灵光：随机抽三条短记，进入视野后依次慢慢浮现；「看看别的」先淡出再换上没看过的三条，抽完一轮再洗牌
  {
    const list = document.getElementById('draw-list');
    const more = document.getElementById('draw-more');
    const pool = JSON.parse(document.getElementById('notes-data').textContent);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COUNT = 3;
    let deck = [];
    let shown = [];
    let swap = 0;

    const shuffle = (a) => {
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };
    const draw = () => {
      if (deck.length < COUNT) {
        const rest = pool.filter((n) => !shown.includes(n) && !deck.includes(n));
        deck = deck.concat(shuffle(rest));
      }
      shown = deck.splice(0, COUNT);
      return shown;
    };

    const render = (items) => {
      list.innerHTML = '';
      items.forEach((n, i) => {
        const li = document.createElement('li');
        li.className = 'draw-note';
        if (!reduce) li.style.transitionDelay = `${i * 0.45}s`;
        const a = document.createElement('a');
        a.className = 'mono draw-date';
        a.href = `/notes#${n.id}`;
        a.innerHTML = `<time datetime="${n.date}">${n.date.replaceAll('-', '.')}</time>`;
        const body = document.createElement('div');
        body.className = 'draw-body';
        body.innerHTML = n.body;
        li.append(a, body);
        list.append(li);
      });
    };
    const reveal = () => {
      list.offsetHeight; // 先让「隐去」状态生效，过渡才会发生
      list.classList.remove('veiled');
    };

    list.classList.add('veiled');
    render(draw());
    more.hidden = false;
    more.addEventListener('click', () => {
      const id = ++swap;
      list.classList.add('veiled');
      setTimeout(() => {
        if (id !== swap) return;
        render(draw());
        reveal();
      }, reduce ? 0 : 600);
    });
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        reveal();
      },
      { threshold: 0.25 },
    );
    io.observe(list);
  }

  // 构建时只写入日期，访问时换成相对时间，避免两次构建之间“2 天前”过期
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  document.querySelectorAll('.rel-date').forEach((el) => {
    const [y, m, d] = el.getAttribute('datetime').split('-').map(Number);
    const days = Math.round((today - new Date(y, m - 1, d)) / 86400000);
    if (days === 0) el.textContent = '今天';
    else if (days === 1) el.textContent = '昨天';
    else if (days > 1 && days < 7) el.textContent = `${days} 天前`;
  });

  document.querySelectorAll('.list-toggle').forEach((btn) => {
    const list = document.getElementById(btn.getAttribute('aria-controls'));
    btn.addEventListener('click', () => {
      const expanded = list.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(expanded));
      btn.querySelector('.toggle-text').textContent = expanded
        ? '收起'
        : `展开其余 ${btn.dataset.count} ${btn.dataset.unit}`;
      if (!expanded) list.scrollIntoView({ block: 'nearest' });
    });
  });
</script>
