---
import Base from '../layouts/Base.astro';
import { profile, products, newsletter, essays, references, projects, lab, contacts } from '../data/content.js';
import { demos } from '../data/demos.js';
import { getNotes } from '../data/notes.js';
import Ascii from 'ascii.rest/astro';
import SiteHeader from '../components/SiteHeader.astro';

const { notes } = await getNotes();
// 灵光：没有脚本时显示最近三条；有脚本时访问时随机换成三条
const drawCount = 3;
const current = products[products.length - 1];
const timeline = [...products].reverse();
const fmtDate = (d) => d.slice(5).replace('-', '.');
// 随手试验区块（04）在没有数据时隐藏，之后的区块编号随之前移
const no = (n) => String(demos.length > 0 || n < 4 ? n : n - 1).padStart(2, '0');
const navLinks = [
  { href: '#notes', label: '灵光' },
  { href: '#products', label: '奇遇' },
  { href: '#projects', label: '项目' },
  ...(demos.length > 0 ? [{ href: '#lab', label: '试验' }] : []),
  { href: '#references', label: '参考' },
  { href: '#essays', label: '文章' },
  { href: '#newsletter', label: '启发' },
  { href: '#contact', label: '联系' },
];
---

<Base>
  <SiteHeader links={navLinks} scramble />

  <main>
    <section class="cover" aria-label="封面">
      <canvas id="cover-rain" aria-hidden="true"></canvas>
      <div class="wrap">
        <div class="art-fit hero-name" style="--cols: 66">
          <Ascii piece="big-text" options={{ text: profile.name.toUpperCase() }} label={profile.name} />
        </div>
      </div>
      <a class="mono scroll-cue" href="#hero" id="scroll-cue">
        <span class="cue-label">scroll<span class="cue-key"> <span class="cue-or">or</span> [ENTER]</span></span>
        <span class="cue-drop" aria-hidden="true"><span>│</span><span>│</span><span>↓</span></span>
      </a>
    </section>

    <section class="hero" id="hero">
      <div class="wrap">
        <p class="mono hero-kicker">PRODUCT · UX · DATA · AI — SINCE {profile.since}</p>
        <div class="hero-body">
          <div class="hero-hello">
            <h1 class="display hello"><span class="prompt" aria-hidden="true">$</span> 你好，我是{profile.cnName}。<span class="cursor" aria-hidden="true"></span></h1>
            <p class="hero-role">{profile.role}</p>
          </div>
          <div class="hero-text">
            <p class="epigraph">“{profile.epigraph}”</p>
            <div class="hero-intro">
              {profile.intro.map((p) => <p>{p}</p>)}
            </div>
            <p class="mono motto"># {profile.motto}</p>
          </div>
          <figure class="art-fit hero-art" style="--cols: 64">
            <Ascii piece="black-hole" fps={15} label="一个黑洞：吸积盘绕着中心旋转，光线被引力弯折" />
            <figcaption class="mono">fig. 1 — mass &amp; pull · ascii.rest</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="notes">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">{no(1)}</span> 灵光 — NOTES</h2>
        <div class="draw-wrap">
          <div class="fig fig-gutter" data-fig="prism"></div>
          <ol class="draw-list" id="draw-list">
            {notes.slice(0, drawCount).map((n) => (
              <li class="draw-note">
                <a class="mono draw-date" href={`/notes#${n.id}`}><time datetime={n.date}>{n.date.replaceAll('-', '.')}</time></a>
                <div class="draw-body" set:html={n.body} />
              </li>
            ))}
          </ol>
        </div>
        <div class="draw-actions">
          <button class="mono draw-more" type="button" id="draw-more" hidden>
            <span class="draw-icon" aria-hidden="true">↻</span> 看看别的
          </button>
          <a class="mono arrow-link draw-all" href="/notes">全部 {notes.length} 条 <span class="arrow">→</span></a>
        </div>
        <script is:inline type="application/json" id="notes-data" set:html={JSON.stringify(notes.map(({ id, date, body }) => ({ id, date, body }))).replaceAll('<', '\\u003c')} />
      </div>
    </section>

    <section class="section" id="products">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">{no(2)}</span> 产品奇遇 — REVIEW</h2>
        <div class="fig" data-fig="annual"></div>
        <p class="section-note">每年我会总结一份当年使用的互联网产品与服务。</p>
        <div class="timeline" role="list">
          <div class="timeline-rail" aria-hidden="true"></div>
          {timeline.map((p) => (
            <a class="timeline-node" class:list={{ current: p.year === current.year }} href={p.href} role="listitem">
              <span class="node-dot" aria-hidden="true"></span>
              <span class="mono node-year">{p.year}</span>
              {p.year === current.year && <span class="mono node-tag">最近</span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">{no(3)}</span> 兴趣项目 — SIDE PROJECTS</h2>
        <p class="section-note">{projects.about}</p>
        <div class="project-grid">
          {projects.items.map((p) => (
            <a class="project-card" href={p.href}>
              <span class="tick tick-tl" aria-hidden="true">+</span>
              <span class="tick tick-tr" aria-hidden="true">+</span>
              <span class="tick tick-bl" aria-hidden="true">+</span>
              <span class="tick tick-br" aria-hidden="true">+</span>
              <p class="mono project-domain">{p.domain} <span class="project-arrow" aria-hidden="true">↗</span></p>
              <p class="display project-name">{p.name}</p>
              <p class="project-desc">{p.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {demos.length > 0 && (
      <section class="section" id="lab">
        <div class="wrap">
          <h2 class="section-label"><span class="index-no">{no(4)}</span> 随手试验 — EXPERIMENTS</h2>
          <div class="fig" data-fig="beaker"></div>
          <p class="section-note">{lab.about}</p>
          <ul class="lab-grid">
            {demos.slice(0, lab.limit).map((d) => (
              <li>
                <a class="lab-card" href={d.url}>
                  <div class="lab-thumb">
                    {d.thumb && <img class:list={{ 'thumb-light': d.thumbDark }} src={d.thumb} alt="" loading="lazy" decoding="async" />}
                    {d.thumb && d.thumbDark && <img class="thumb-dark" src={d.thumbDark} alt="" loading="lazy" decoding="async" />}
                  </div>
                  <p class="mono lab-date">
                    <time class="rel-date" datetime={d.date}>{fmtDate(d.date)}</time>
                    <span class="lab-arrow" aria-hidden="true">↗</span>
                  </p>
                  <p class="display lab-title">{d.title}</p>
                </a>
              </li>
            ))}
          </ul>
          <a class="mono arrow-link lab-all" href={lab.href}>
            全部 {demos.length} 个 demo · {lab.domain} <span class="arrow">→</span>
          </a>
        </div>
      </section>
    )}

    <section class="section" id="references">
      <div class="wrap">
        <h2 class="section-label"><span class="index-no">{no(5)}</span> 参考文本 — REFERENCE</h2>
        <div class="ref-grid">
          {references.map((r) => (
            <a class="ref-card" href={r.href}>
              <span class="tick tick-tl" aria-hidden="true">+</span>
              <span class="tick tick-tr" aria-hidden="true">+</span>
              <span class="tick tick-bl" aria-hidden="true">+</span>
              <span class="tick tick-br" aria-hidden="true">+</span>
              <p class="mono ref-label">{r.label}</p>
              <p class="display ref-title">{r.title}</p>
              <p class="ref-desc">{r.desc}</p>
              <span class="mono ref-go">阅读 <span class="arrow">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="essays">
      <div class="wrap" data-reveal>
        <h2 class="section-label"><span class="index-no">{no(6)}</span> 但说无妨 — ESSAYS</h2>
        <p class="section-note">{essays.about}</p>
        {essays.groups.map((g) => (
          <div class="essay-group">
            <h3 class="mono essay-year">{g.year} →</h3>
            <ul class="essay-list" id={`essay-list-${g.year}`}>
              {g.items.map((e, idx) => (
                <li class:list={{ 'list-extra': idx >= 5 }} style={idx >= 5 ? `--i: ${idx - 5}` : undefined}>
                  <a class="essay-row" href={e.href}>
                    <span class="essay-title">{e.title}</span>
                    <span class="leader" aria-hidden="true"></span>
                    <span class="mono essay-no">{e.no}</span>
                  </a>
                </li>
              ))}
            </ul>
            {g.items.length > 5 && (
              <button
                class="mono list-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`essay-list-${g.year}`}
                data-count={g.items.length - 5}
                data-unit="篇"
              >
                <span class="toggle-plus" aria-hidden="true">+</span>
                <span class="toggle-text">展开其余 {g.items.length - 5} 篇</span>
              </button>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="newsletter">
      <div class="wrap" data-reveal>
        <h2 class="section-label"><span class="index-no">{no(7)}</span> 有所启发 — NEWSLETTER</h2>
        <p class="section-note">
          {newsletter.about}
          <a class="arrow-link subscribe" href={newsletter.subscribe}>欢迎订阅 <span class="arrow">→</span></a>
        </p>
        <ul class="issue-list" id="issue-list">
          {newsletter.issues.map((i, idx) => (
            <li class:list={{ 'list-extra': idx >= 5 }} style={idx >= 5 ? `--i: ${idx - 5}` : undefined}>
              <a class="issue-row" href={i.href}>
                <span class="mono issue-no">#{i.no}</span>
                <span class="issue-title">{i.title}</span>
                <span class="mono issue-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        {newsletter.issues.length > 5 && (
          <button
            class="mono list-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="issue-list"
            data-count={newsletter.issues.length - 5}
            data-unit="期"
          >
            <span class="toggle-plus" aria-hidden="true">+</span>
            <span class="toggle-text">展开其余 {newsletter.issues.length - 5} 期</span>
          </button>
        )}
        <div class="fig fig-end" data-fig="typewriter"></div>
      </div>
    </section>

  </main>

  <footer class="footer" id="contact">
    <canvas id="ascii-field" aria-hidden="true"></canvas>
    <div class="wrap">
      <h2 class="section-label"><span class="index-no">{no(8)}</span> 在这些地方找到我 — FIND ME</h2>
      <ul class="contact-list">
        {contacts.map((c) => (
          <li class="contact-item">
            <span class="mono contact-label">{c.label}</span>
            {c.href ? (
              <a class="arrow-link contact-value" href={c.href}>{c.value} <span class="arrow">↗</span></a>
            ) : (
              <span class="contact-value">{c.value}</span>
            )}
          </li>
        ))}
      </ul>
      <p class="mono footer-motto">© {new Date().getFullYear()} Yishan · {profile.motto} · <a class="licenses" href="/resume">Resume</a> · <a class="licenses" href="/licenses.txt">第三方许可</a></p>
    </div>
  </footer>
</Base>

<style>
  /* 封面：占满首屏，只放大字；底部是向下滚动的提示 */
  .cover {
    position: relative;
    min-height: calc(100svh - 58px);
    display: flex;
    align-items: center;
    padding: 48px 0 120px;
    border-bottom: 1px solid var(--hairline);
  }
  .cover > .wrap {
    position: relative;
    width: 100%;
  }
  #cover-rain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  .scroll-cue {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    color: var(--ink-2);
    letter-spacing: 0.16em;
  }
  .cue-or {
    color: var(--ink-3);
  }
  /* 触屏设备没有回车键，只提示滑动 */
  @media (hover: none) {
    .cue-key { display: none; }
  }
  .cue-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    font-size: 14px;
  }
  /* 三格字符依次点亮，像一个往下掉的点 */
  .cue-drop span {
    color: var(--ink-3);
    animation: cue-fall 1.8s steps(1) infinite;
  }
  .cue-drop span:nth-child(2) { animation-delay: 0.3s; }
  .cue-drop span:nth-child(3) { animation-delay: 0.6s; }
  @keyframes cue-fall {
    0% { color: var(--vermillion); }
    17% { color: var(--ink-3); }
  }
  .scroll-cue:hover,
  .scroll-cue:hover .cue-or {
    color: var(--vermillion);
  }
  @media (prefers-reduced-motion: reduce) {
    .cue-drop span { animation: none; }
    .cue-drop span:last-child { color: var(--vermillion); }
  }

  .hero {
    position: relative;
    padding: 80px 0 80px;
  }
  .hero-kicker {
    margin-bottom: 18px;
  }
  /* 字符作品按列数铺满容器：字号 = 容器宽 / (列数 × 字宽) */
  .art-fit {
    container-type: inline-size;
    margin: 0;
  }
  .art-fit :global(ascii-art) {
    display: block;
    font-family: var(--mono);
    font-size: min(var(--max-px, 26px), calc(100cqw / (var(--cols) * 0.61)));
    line-height: 1.15;
    color: var(--ink);
  }
  .art-fit :global(pre) {
    margin: 0;
    font: inherit;
  }
  .hero-name :global(ascii-art) {
    color: var(--ink);
    line-height: 1;
  }
  /* 两行网格：第一行只放问候语；第二行左为引言与介绍、右为黑洞图，两者顶部对齐 */
  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px 48px;
    margin-top: 40px;
    align-items: start;
  }
  .hero-hello {
    grid-column: 1;
  }
  .hero-text {
    grid-column: 1;
    grid-row: 2;
  }
  .hero-art {
    grid-column: 2;
    grid-row: 2;
  }
  .hello {
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.5;
  }
  .prompt {
    color: var(--vermillion);
    margin-right: 0.4ch;
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.3ch;
    vertical-align: -0.15em;
    background: var(--vermillion);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .hero-role {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--vermillion);
    margin-top: 6px;
    letter-spacing: 0.12em;
  }
  .epigraph {
    font-family: var(--mono);
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink);
    padding-left: 2ch;
    border-left: 2px solid var(--vermillion);
  }
  .hero-intro {
    margin-top: 24px;
    display: grid;
    gap: 12px;
    color: var(--ink-2);
    font-size: 14px;
  }
  .motto {
    margin-top: 24px;
    color: var(--ink-2);
  }
  .hero-art {
    --max-px: 12px;
    padding: 8px;
    border: 1px dashed var(--hairline-strong);
  }
  .hero-art figcaption {
    margin-top: 8px;
    font-size: 11px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor { animation: none; }
  }

  /* 自绘等距线稿：浮在区块说明右侧；线宽与配色对齐 Hairline 的做法，颜色取站点变量 */
  .fig {
    float: right;
    width: var(--fig-w, 195px);
    margin: -16px 0 16px 32px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    --fg-plate: var(--paper);
    --fg-hi: var(--ink);
    --fg-edge: color-mix(in srgb, var(--ink) 55%, transparent);
    --fg-mid: color-mix(in srgb, var(--ink) 32%, transparent);
    --fg-lo: color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .fig :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .fig :global(:is(polygon, polyline, line, circle)) {
    fill: var(--fg-plate);
    stroke: var(--fg-mid);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .fig :global(.fo) {
    stroke: var(--fg-plate);
    stroke-width: 0.6;
  }
  .fig :global(.nf) { fill: none; }
  .fig :global(.sil) { stroke: var(--fg-edge); }
  .fig :global(.lo) { stroke: var(--fg-lo); }
  .fig :global(.hi) { stroke: var(--fg-hi); }
  .fig :global(.accent) { stroke: var(--vermillion); }
  .fig :global(.fo.accent) { fill: var(--vermillion); }
  /* 放在区块末尾、不与列表并排的图形：右对齐占一行 */
  /* 放在列表右侧空白里的图形：不浮动、不挤压列表；空白不够宽时隐藏 */
  .draw-wrap {
    position: relative;
  }
  .fig-gutter {
    position: absolute;
    right: 0;
    top: 0;
    float: none;
    margin: 0;
  }
  @media (max-width: 1100px) {
    .fig-gutter { display: none; }
  }
  /* 文章与启发列表：进入视野后逐条从淡、微糊里浮现，每条 0.6 秒。
     只有脚本加上 .rv 才隐藏，没有脚本或减弱动态时内容照常显示 */
  .rv :is(.essay-year, .essay-list > li:not(.list-extra), .issue-list > li:not(.list-extra)) {
    opacity: 0;
    filter: blur(3px);
    translate: 0 4px;
  }
  .rv.rv-in :is(.essay-year, .essay-list > li:not(.list-extra), .issue-list > li:not(.list-extra)) {
    opacity: 1;
    filter: none;
    translate: 0 0;
    transition:
      opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
      filter 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
      translate 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
    transition-delay: var(--d, 0s);
  }
  .fig-end {
    float: none;
    margin: 8px 0 0 auto;
  }
  .timeline,
  .project-grid,
  .lab-grid,
  .issue-list {
    clear: both;
  }
  @media (max-width: 720px) {
    .fig { display: none; }
  }

  /* 灵光：三条短记，左边日期，右边全文 */
  .draw-list {
    list-style: none;
    padding: 0;
    max-width: 820px;
  }
  .draw-list :global(.draw-note) {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 24px;
    padding: 18px 8px;
    border-bottom: 1px dashed var(--hairline-strong);
  }
  .draw-list :global(.draw-date) {
    padding-top: 3px;
    font-size: 13px;
    color: var(--ink-3);
    transition: color 0.25s ease;
  }
  .draw-list :global(.draw-note:hover .draw-date) {
    color: var(--vermillion);
  }
  .draw-list :global(.draw-body) {
    font-size: 15px;
    line-height: 1.9;
    min-width: 0;
  }
  .draw-list :global(.draw-body p + p) {
    margin-top: 0.7em;
  }
  .draw-list :global(.draw-body a) {
    color: var(--vermillion);
    border-bottom: 1px dotted var(--hairline-strong);
  }
  /* 浮现：三条依次从淡、微糊里慢慢清晰，不抢注意力 */
  .draw-list :global(.draw-note) {
    transition:
      opacity 1.6s cubic-bezier(0.25, 0.1, 0.25, 1),
      filter 1.6s cubic-bezier(0.25, 0.1, 0.25, 1),
      translate 1.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }
  .draw-list.veiled :global(.draw-note) {
    opacity: 0;
    filter: blur(3px);
    translate: 0 4px;
    transition-duration: 0.6s;
    transition-delay: 0s !important;
  }
  .draw-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
  }
  .draw-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 0;
    background: none;
    border: none;
    border-bottom: 1px dotted var(--hairline-strong);
    cursor: pointer;
    color: var(--ink);
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .draw-more:hover {
    color: var(--vermillion);
    border-bottom-color: var(--vermillion);
  }
  .draw-icon {
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .draw-more:hover .draw-icon {
    transform: rotate(180deg);
  }
  .draw-all {
    color: var(--ink-2);
    border-bottom: 1px dotted var(--hairline-strong);
    padding-bottom: 2px;
  }
  @media (max-width: 720px) {
    .draw-list :global(.draw-note) {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }

  .section-note {
    max-width: 620px;
    color: var(--ink-2);
    font-size: 15px;
