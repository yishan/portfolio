---
import Article from '../layouts/Article.astro';
import { getNotes } from '../data/notes.js';

const { entry, intro, notes } = await getNotes();

const years = [...new Set(notes.map((n) => n.year))].map((year) => ({
  year,
  items: notes.filter((n) => n.year === year),
}));
---

<Article
  title={entry.data.title}
  date={notes[0]?.date ?? entry.data.latest}
  description={entry.data.description}
>
  {intro && <div class="notes-intro" set:html={intro} />}

  {years.map((g) => (
    <section class="year" aria-labelledby={`y-${g.year}`}>
      <h2 class="mono year-label" id={`y-${g.year}`}>{g.year}</h2>
      <ol class="notes">
        {g.items.map((n) => (
          <li class="note" id={n.id}>
            <a class="mono note-date" href={`#${n.id}`} aria-label={`${n.date} 的短记链接`}>
              <time datetime={n.date}>{n.label}</time>
            </a>
            <div class="note-body" set:html={n.body} />
          </li>
        ))}
      </ol>
    </section>
  ))}
</Article>

<style>
  .notes-intro {
    color: var(--ink-2);
    margin-bottom: 56px;
  }

  .year + .year {
    margin-top: 56px;
  }
  .year h2.year-label {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    margin: 0 0 20px;
  }
  :global(.prose) .notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  :global(.prose) .note {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 16px;
    margin: 0;
    padding: 0 0 22px;
    scroll-margin-top: 80px;
  }
  :global(.prose) a.note-date {
    padding-top: 4px;
    font-size: 13px;
    line-height: 1.9;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .note-body {
    min-width: 0;
  }
  :global(.prose) .note-body :global(p:last-child) {
    margin-bottom: 0;
  }
  :global(.prose) .note:hover a.note-date,
  :global(.prose) .note:target a.note-date {
    color: var(--vermillion);
  }

  @media (max-width: 720px) {
    :global(.prose) .note {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
