---
import Article from '../layouts/Article.astro';
import data from '../data/read.json';

// 数据由 scripts/read-data.mjs 从微信读书生成，私密阅读的书不在里面
const pad = (n) => String(n).padStart(2, '0');
const dot = (date) => date.replaceAll('-', '.');
const hrs = (s) => (s >= 3600 ? `${Math.round(s / 3600)} 小时` : `${Math.max(1, Math.round(s / 60))} 分钟`);
const bar = (v, peak, width, ch = '█') => (v ? ch.repeat(Math.max(1, Math.round((v / peak) * width))) : '·');
// 书名去掉括号里的副标题和营销语
const short = (t) => t.replace(/[（(【].*$/, '').trim() || t;
const SHADES = ['·', '░', '▒', '▓', '█'];

// 01 每年：从第一年有记录的那年起
const years = data.years.slice(data.years.findIndex((y) => y.s > 0));
const yearPeak = Math.max(...years.map((y) => y.s));
const monthPeak = Math.max(1, ...years.flatMap((y) => y.months));
const monthShade = (s) => SHADES[s ? Math.max(1, Math.ceil((s / monthPeak) * 4)) : 0];
const topYear = years.reduce((a, b) => (b.s > a.s ? b : a));

// 02 最近一年每天：一列一周，周一在上
const dayShade = (s) => SHADES[s <= 0 ? 0 : s < 900 ? 1 : s < 2700 ? 2 : s < 5400 ? 3 : 4];
const lead = (new Date(`${data.daily[0].date}T12:00:00`).getDay() + 6) % 7;
const cells = [...Array(lead).fill(null), ...data.daily];
const weeks = [];
for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));
// 每月 1 号所在的那一周标月份；第一列离下个月不到三周时不标，免得挤在一起
const monthMarks = weeks.map((w) => {
  const first = w.find((d) => d && d.date.endsWith('-01'));
  return first ? Number(first.date.slice(5, 7)) : null;
});
if (monthMarks.findIndex((m) => m !== null) >= 3) monthMarks[0] = Number(data.daily[0].date.slice(5, 7));
const readDays = data.daily.filter((d) => d.s >= 60);
const longestDay = data.daily.reduce((a, b) => (b.s > a.s ? b : a));
const yearTotal = data.daily.reduce((s, d) => s + d.s, 0);
const WEEKDAYS = ['一', '', '三', '', '五', '', '日'];

// 03 一天里：24 小时，每列最多 8 格
const SPARK = ' ▁▂▃▄▅▆▇█';
const hourPeak = Math.max(1, ...data.hours);
const COL_H = 6;
const hourCols = data.hours.map((s, h) => {
  const units = Math.round((s / hourPeak) * COL_H * 8);
  const full = Math.floor(units / 8);
  const part = units % 8;
  return { h, s, full, part };
});
const peakHour = data.hours.indexOf(hourPeak);

// 04 读得最久
const longPeak = Math.max(1, ...data.longest.map((b) => b.s));

// 05 读什么：按阅读时长；书架上的书按大类数
const catPeak = Math.max(1, ...data.categories.map((c) => c.s));
const catLabel = (c) => (c.parent && c.parent !== c.title ? `${c.parent} · ${c.title}` : c.title);
const SHELF_SHOWN = 10;
const shelfRows = data.shelf.parents.slice(0, SHELF_SHOWN);
const shelfRest = data.shelf.parents.slice(SHELF_SHOWN);
if (shelfRest.length) shelfRows.push({ name: `其他 ${shelfRest.length} 类`, n: shelfRest.reduce((s, p) => s + p.n, 0) });
const shelfPeak = Math.max(1, ...shelfRows.map((p) => p.n));

// 07 笔记最多
const notePeak = Math.max(1, ...data.notebooks.top.map((b) => b.highlights));
---

<Article
  title="Yishan ⨯ 微信读书"
  docTitle="Yishan ⨯ 微信读书"
  date={data.generated_at}
  description="我在微信读书上的阅读记录：每年读多久、一天里什么时候读、读得最久的书、划线最多的书。"
>
  <div class="rd-intro">
    <p>我的微信读书记录</p>
    <p class="mono rd-stats">
      <span><b>{Math.round(data.total_s / 3600)}</b> 小时</span>
      <span><b>{data.days}</b> 天</span>
      <span>读过 <b>{data.read}</b> 本</span>
      <span>读完 <b>{data.finished}</b> 本</span>
      <span><b>{data.notes}</b> 条笔记</span>
      <span>{dot(data.since)} 开始</span>
    </p>
  </div>

  <section class="rd-sec" aria-labelledby="rd-01">
    <h2 class="rd-h" id="rd-01">每年读多久</h2>
    <p class="rd-sub">一行一年，中间十二格是十二个月，格子越深读得越久。</p>
    <div class="rd-scroll rd-fig">
      <div class="mono yr" role="table" aria-label="每年每月的阅读时长">
        <span role="columnheader"></span>
        <span class="yr-m yr-mh" role="columnheader">{Array.from({ length: 12 }, (_, i) => <span>{i % 3 === 0 ? i + 1 : ''}</span>)}</span>
        <span role="columnheader"></span>
        <span role="columnheader"></span>
        {years.map((y) => (
          <>
            <span class="yr-y" role="rowheader">{y.year}</span>
            <span class="yr-m" role="cell">
              {y.months.map((s, i) => <span title={`${y.year}.${pad(i + 1)} · ${hrs(s)}`}>{monthShade(s)}</span>)}
            </span>
            <span class="yr-bar" role="cell" aria-hidden="true">{bar(y.s, yearPeak, 24)}</span>
            <span class="yr-n" role="cell">{Math.round(y.s / 3600)} 小时<span class="yr-d"> · {y.days} 天</span></span>
          </>
        ))}
      </div>
    </div>
    <p class="mono rd-cap">读得最多的是 {topYear.year} 年，{Math.round(topYear.s / 3600)} 小时 · {SHADES.join(' ')} 由少到多</p>
  </section>

  <section class="rd-sec" aria-labelledby="rd-02">
    <h2 class="rd-h" id="rd-02">最近一年的每一天</h2>
    <p class="rd-sub">一列一周，从上到下周一到周日。</p>
    <div class="rd-scroll rd-fig">
      <div class="mono cal" style={`--weeks: ${weeks.length}`} role="img" aria-label={`最近一年有 ${readDays.length} 天在读书`}>
        <span></span>
        {monthMarks.map((m) => <span class="cal-m">{m ?? ''}</span>)}
        {WEEKDAYS.map((w, d) => (
          <>
            <span class="cal-d">{w}</span>
            {weeks.map((wk) => {
              const c = wk[d];
              return c ? <span class="cal-c" title={`${dot(c.date)} · ${c.s ? hrs(c.s) : '没读'}`}>{dayShade(c.s)}</span> : <span></span>;
            })}
          </>
        ))}
      </div>
    </div>
    <p class="mono rd-cap">
      {readDays.length} 天在读，共 {hrs(yearTotal)}；读得最久的一天是 {dot(longestDay.date)}，{hrs(longestDay.s)} · ░ 一刻钟内 ▒ 三刻钟内 ▓ 一个半小时内 █ 更久
    </p>
  </section>

  <section class="rd-sec" aria-labelledby="rd-03">
    <h2 class="rd-h" id="rd-03">一天里的什么时候</h2>
    <p class="rd-sub">所有年份合在一起，每个钟头读了多久。</p>
    <div class="rd-scroll rd-fig">
      <div class="mono hrs" style={`--h: ${COL_H}`} role="img" aria-label={`一天里各时段的阅读时长，最常在 ${peakHour} 点读`}>
        {hourCols.map((c) => (
          <span class="hrs-col" title={`${c.h} 点 · ${hrs(c.s)}`}>
            <span class="hrs-bar" aria-hidden="true">
              {c.part > 0 && <i>{SPARK[c.part]}</i>}
              {Array.from({ length: c.full }, () => <i>█</i>)}
              {!c.full && !c.part && <i class="empty">·</i>}
            </span>
            <span class="hrs-l">{c.h % 3 === 0 ? c.h : ''}</span>
          </span>
        ))}
      </div>
    </div>
    <p class="mono rd-cap">最常在 {peakHour} 点读</p>
  </section>

  <section class="rd-sec" aria-labelledby="rd-04">
    <h2 class="rd-h" id="rd-04">读得最久的书</h2>
    <p class="rd-sub">按每本书累计的阅读时长。</p>
    <ol class="mono rows rd-fig">
      {data.longest.map((b) => (
        <li class="row">
          <span class="row-t"><a href={b.link} title={b.title}>{short(b.title)}</a><span class="row-a"> · {b.author}</span></span>
          <span class="row-bar" aria-hidden="true">{bar(b.s, longPeak, 18, '▇')}</span>
          <span class="row-n">{hrs(b.s)}</span>
        </li>
      ))}
    </ol>
    {data.longest.some((b) => b.tags.length) && (
      <p class="mono rd-cap">{data.longest.filter((b) => b.tags.length).map((b) => `${short(b.title)}：${b.tags.join('、')}`).join(' · ')}</p>
    )}
  </section>

  <section class="rd-sec" aria-labelledby="rd-05">
    <h2 class="rd-h" id="rd-05">读什么</h2>
    <p class="rd-sub">先是各类书读了多久，再是书架上 {data.shelf.books} 本公开的书按大类数。</p>
    <div class="cats rd-fig">
      <ul class="mono rows">
        {data.categories.map((c) => (
          <li class="row cat-row">
            <span class="row-t">{catLabel(c)}</span>
            <span class="row-bar" aria-hidden="true">{bar(c.s, catPeak, 12)}</span>
            <span class="row-n">{Math.round(c.s / 3600)} 小时<span class="row-a"> · {c.n} 本</span></span>
          </li>
        ))}
      </ul>
      <ul class="mono rows">
        {shelfRows.map((p) => (
          <li class="row cat-row">
            <span class="row-t">{p.name}</span>
            <span class="row-bar" aria-hidden="true">{bar(p.n, shelfPeak, 12, '▒')}</span>
            <span class="row-n">{p.n} 本</span>
          </li>
        ))}
      </ul>
    </div>
    <p class="mono rd-cap">书架上的书读完了 {data.shelf.finished} 本</p>
  </section>

  <section class="rd-sec" aria-labelledby="rd-06">
    <h2 class="rd-h" id="rd-06">作者与出版社</h2>
    <p class="rd-sub">读得多的作者（按时长），和读得多的出版社（按本数）。</p>
    <div class="cats rd-fig">
      <ul class="mono rows">
        {data.authors.map((a) => (
          <li class="row cat-row">
            <span class="row-t">{a.name}</span>
            <span class="row-bar" aria-hidden="true">{'▪'.repeat(a.n)}</span>
            <span class="row-n">{a.time}</span>
          </li>
        ))}
      </ul>
      <ul class="mono rows">
        {data.publishers.map((p) => (
          <li class="row cat-row">
            <span class="row-t">{p.name}</span>
            <span class="row-bar" aria-hidden="true">{bar(p.n, data.publishers[0].n, 12, '▒')}</span>
            <span class="row-n">{p.n} 本</span>
          </li>
        ))}
      </ul>
    </div>
    <p class="mono rd-cap">▪ 一个方块一本 · 一共读过 {data.author_count} 位作者的书</p>
  </section>

  <section class="rd-sec" aria-labelledby="rd-07">
    <h2 class="rd-h" id="rd-07">划线最多的书</h2>
    <p class="rd-sub">{data.notebooks.books} 本书里留了笔记。这里按划线、想法和书签加起来排。</p>
    <ol class="mono rows rd-fig">
      {data.notebooks.top.map((b) => (
        <li class="row note-row">
          <span class="row-t"><a href={b.link} title={b.title}>{short(b.title)}</a></span>
          <span class="row-bar" aria-hidden="true">{bar(b.highlights, notePeak, 12, '▇')}</span>
          <span class="row-n">{b.highlights}<span class="row-a"> 划线{b.thoughts ? ` · ${b.thoughts} 想法` : ''}</span></span>
        </li>
      ))}
    </ol>
  </section>

  <section class="rd-sec" aria-labelledby="rd-08">
    <h2 class="rd-h" id="rd-08">最近翻开的</h2>
    <p class="rd-sub">书架上最近读过的几本。</p>
    <ul class="mono recent rd-fig">
      {data.shelf.recent.map((b) => (
        <li class="recent-row">
          <span class="recent-d">{dot(b.date).slice(5)}</span>
          <span class="row-t"><a href={b.link} title={b.title}>{short(b.title)}</a><span class="row-a"> · {b.author}</span></span>
          <span class="recent-s">{b.finished ? '读完' : '在读'}</span>
        </li>
      ))}
    </ul>
    <p class="mono rd-cap">数据来自微信读书 · {dot(data.generated_at.slice(0, 10))} 更新</p>
  </section>
</Article>

<style>
  .rd-intro {
    margin-bottom: 64px;
  }
  .rd-intro p {
    color: var(--ink-2);
  }
  :global(.prose) .rd-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 20px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .rd-stats b {
    font-weight: 500;
    color: var(--ink);
  }

  .rd-sec + .rd-sec {
    margin-top: 72px;
  }
  :global(.prose) h2.rd-h {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin: 0 0 10px;
  }
  :global(.prose) .rd-sub {
    font-size: 14px;
    color: var(--ink-2);
    margin-bottom: 24px;
  }
  :global(.prose) .rd-cap {
    margin: 18px 0 0;
    font-size: 12px;
    line-height: 1.8;
    color: var(--ink-2);
    letter-spacing: 0.04em;
  }
  .rd-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .rd-scroll > :global(*) {
    min-width: 600px;
  }

  /* 01 每年 */
  .yr {
    display: grid;
    grid-template-columns: 4ch auto 1fr 18ch;
    gap: 2px 2ch;
    align-items: baseline;
    font-size: 12px;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .yr-m.yr-mh {
    font-size: 10px;
    color: var(--ink-2);
  }
  .yr-y {
    color: var(--ink);
  }
  .yr-m {
    display: flex;
    font-size: 14px;
    letter-spacing: 0;
  }
  .yr-m > span {
    width: 1.25em;
    text-align: center;
  }
  .yr-mh > span {
    width: 1.75em;
    text-align: left;
  }
  .yr-m span:hover {
    color: var(--vermillion);
  }
  .yr-bar {
    color: var(--ink-2);
    letter-spacing: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .yr-n {
    color: var(--ink);
    text-align: right;
    white-space: nowrap;
  }
  .yr-d {
    color: var(--ink-2);
  }

  /* 02 每天 */
  .cal {
    display: grid;
    grid-template-columns: 2em repeat(var(--weeks), 1fr);
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: 0;
    color: var(--ink-2);
    text-align: center;
  }
  .cal-m {
    font-size: 10px;
    color: var(--ink-2);
    text-align: left;
    white-space: nowrap;
    overflow: visible;
  }
  .cal-d {
    font-size: 10px;
    color: var(--ink-2);
    text-align: left;
  }
  .cal-c:hover {
    color: var(--vermillion);
  }

  /* 03 一天里 */
  .hrs {
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 0 2px;
    letter-spacing: 0;
  }
  .hrs-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    min-height: calc(var(--h) * 14px + 24px);
  }
  .hrs-bar {
    display: flex;
    flex-direction: column;
    font-size: 16px;
    line-height: 14px;
    color: var(--ink-2);
  }
  .hrs-bar i {
    font-style: normal;
  }
  .hrs-bar i.empty {
    color: var(--ink-2);
  }
  .hrs-col:hover .hrs-bar {
    color: var(--vermillion);
  }
  .hrs-l {
    margin-top: 6px;
    height: 1.4em;
    font-size: 10px;
    align-self: stretch;
    text-align: center;
  }

  /* 列表：书名 + ASCII 横条 + 数字 */
  :global(.prose) .rows,
  :global(.prose) .recent {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 12px;
  }
  :global(.prose) .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18ch 9ch;
    gap: 1.5ch;
    align-items: baseline;
    margin: 0;
    line-height: 2;
    color: var(--ink-2);
  }
  :global(.prose) .note-row {
    grid-template-columns: minmax(0, 1fr) 12ch 15ch;
  }
  :global(.prose) .cat-row {
    grid-template-columns: minmax(0, 1fr) 12ch 12ch;
  }
  .row-t {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  :global(.prose) .row-t a {
    color: inherit;
    text-decoration: none;
  }
  :global(.prose) .row-t a:hover {
    color: var(--vermillion);
  }
  .row-a {
    font-size: 12px;
    color: var(--ink-2);
  }
  .row-bar {
    color: var(--ink-2);
    letter-spacing: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .row-n {
    color: var(--ink);
    text-align: right;
    white-space: nowrap;
  }

  /* 05 / 06：两栏，窄屏叠起来 */
  .cats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 4ch;
  }

  /* 08 最近 */
  :global(.prose) .recent-row {
    display: grid;
    grid-template-columns: 6ch minmax(0, 1fr) 4ch;
    gap: 1.5ch;
    align-items: baseline;
    margin: 0;
    line-height: 2;
    color: var(--ink-2);
  }
  .recent-s {
    text-align: right;
  }

  .rv .rd-fig {
    opacity: 0;
    translate: 0 4px;
    transition: opacity 0.6s ease, translate 0.6s ease;
  }
  .rv.rv-in .rd-fig {
    opacity: 1;
    translate: 0 0;
  }

  @media (max-width: 720px) {
    .cats {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    :global(.prose) .row {
      grid-template-columns: minmax(0, 1fr) 9ch;
    }
    :global(.prose) .note-row {
      grid-template-columns: minmax(0, 1fr) 14ch;
    }
    :global(.prose) .cat-row {
      grid-template-columns: minmax(0, 1fr) 12ch;
    }
    .row .row-bar {
      display: none;
    }
  }
</style>

<script>
  // 02：默认滚到最近一周
  document.querySelectorAll('.cal').forEach((el) => (el.parentElement.scrollLeft = el.parentElement.scrollWidth));

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach(({ isIntersecting, target }) => {
          if (!isIntersecting) return;
          io.unobserve(target);
          target.classList.add('rv-in');
        });
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('.rd-sec').forEach((sec) => {
      sec.classList.add('rv');
      io.observe(sec);
    });
  }
</script>
