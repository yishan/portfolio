---
import Article from '../layouts/Article.astro';
import data from '../data/listen.json';

// 数据由 scripts/listen-data.mjs 每天生成一次。积累不满 MIN_DAYS 天的部分先显示「记录中」
const MIN_DAYS = 14;
const TERMS = [
  { key: 'long_term', label: '长期', span: '约一年' },
  { key: 'medium_term', label: '中期', span: '约半年' },
  { key: 'short_term', label: '短期', span: '约四周' },
];
const pad = (n) => String(n).padStart(2, '0');
const dot = (date) => date.replaceAll('-', '.');
const pct = (a, b) => (b ? Math.round((a / b) * 100) : 0);
const list = (names) => names.join('、');
const top = data.top;

// 01 艺人名次变化：每列前 ROWS 名，相邻两列都出现的艺人连一条线；三个时段的完整榜单里都有的画实线
const ROWS = 20;
const ROW_H = 22;
const artistSets = TERMS.map((t) => new Set(top.artists[t.key].map((a) => a.id)));
const inAll = (id) => artistSets.every((s) => s.has(id));
const stayed = top.artists.short_term.filter((a) => inAll(a.id));
const bumpCols = TERMS.map((t, i) =>
  top.artists[t.key].slice(0, ROWS).map((a) => ({
    ...a,
    all: inAll(a.id),
    // 短期榜里，中期和长期都没有出现过的
    fresh: i === 2 && !artistSets[0].has(a.id) && !artistSets[1].has(a.id),
  })),
);
const bumpLinks = [0, 1].map((i) => {
  const right = new Map(bumpCols[i + 1].map((a) => [a.id, a.rank]));
  return bumpCols[i]
    .filter((a) => right.has(a.id))
    .map((a) => {
      const y1 = (a.rank - 0.5) * ROW_H;
      const y2 = (right.get(a.id) - 0.5) * ROW_H;
      return { id: a.id, all: a.all, d: `M0 ${y1} C28 ${y1} 28 ${y2} 56 ${y2}` };
    });
});

// 02 流派：MusicBrainz 标签归成大类后，各时段艺人里每一类的占比
const genres = data.genres;
const GENRE_BAR = 12;
const genreRows = genres
  ? genres.families
      .map((f) => ({
        ...f,
        share: TERMS.map((t) => genres.terms[t.key].share[f.key] ?? 0),
        examples: genres.terms.short_term.examples[f.key] ?? genres.terms.long_term.examples[f.key] ?? [],
      }))
      .filter((f) => Math.max(...f.share) >= 0.02)
      .sort((a, b) => (a.key === 'other') - (b.key === 'other') || b.share.reduce((x, y) => x + y) - a.share.reduce((x, y) => x + y))
  : [];
const genrePeak = Math.max(0.01, ...genreRows.flatMap((f) => f.share));
const genreBar = (v) => (v ? '█'.repeat(Math.max(1, Math.round((v / genrePeak) * GENRE_BAR))) : '·');
// 一年来到最近四周，占比变化最大的两类
const genreShift = genreRows
  .filter((f) => f.key !== 'other')
  .map((f) => ({ ...f, delta: f.share[2] - f.share[0] }))
  .sort((a, b) => b.delta - a.delta);
const rising = genreShift[0];
const falling = genreShift.at(-1);
const points = (v) => Math.abs(Math.round(v * 100));
const trackRows = TERMS.map((t) => top.tracks[t.key]);

// 三个时段的歌合在一起去重，03 和 04 都按这份算
const uniqueTracks = [...new Map(trackRows.flat().map((x) => [x.id, x])).values()];

const TW = 720;

// 03 唱片登记地：ISRC 前两位
const regionName = new Intl.DisplayNames(['zh-CN'], { type: 'region' });
const SHORT_NAMES = { HK: '香港', MO: '澳门', TW: '台湾' };
const ccLabel = (cc) => {
  if (/^Q[A-Z]$/.test(cc)) return '美国 · 独立发行';
  if (SHORT_NAMES[cc]) return SHORT_NAMES[cc];
  try {
    return regionName.of(cc);
  } catch {
    return cc;
  }
};
const ccCount = new Map();
for (const x of uniqueTracks) if (x.cc) ccCount.set(x.cc, (ccCount.get(x.cc) ?? 0) + 1);
const ccSorted = [...ccCount].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const CC_SHOWN = 9;
const ccRows = ccSorted.slice(0, CC_SHOWN).map(([cc, n]) => ({ cc, n, label: ccLabel(cc) }));
const ccRest = ccSorted.slice(CC_SHOWN);
if (ccRest.length) ccRows.push({ cc: '··', n: ccRest.reduce((s, [, n]) => s + n, 0), label: `其他 ${ccRest.length} 地` });
const ccTotal = ccRows.reduce((s, r) => s + r.n, 0);
const ccPeak = Math.max(...ccRows.map((r) => r.n));
const CC_BAR = 28;

// 04 发行年代：每首歌一个点，按发行年份叠起来
const dated = uniqueTracks.filter((x) => x.year);
const yNow = Number(data.until.slice(0, 4));
const y0 = Math.floor(Math.min(...dated.map((x) => x.year)) / 10) * 10;
const yearCount = new Map();
for (const x of dated) yearCount.set(x.year, (yearCount.get(x.year) ?? 0) + 1);
const yPeak = Math.max(...yearCount.values());
const YCOL = TW / (yNow - y0 + 1);
const YDOT = 5.5;
const YH = yPeak * YDOT + 44;
const yBase = YH - 26;
const yDots = [];
for (const [y, n] of yearCount) {
  for (let i = 0; i < n; i++) yDots.push({ cx: (y - y0 + 0.5) * YCOL, cy: yBase - 4 - i * YDOT });
}
const decades = [];
for (let d = y0; d <= yNow; d += 10) decades.push(d);
const oldest = dated.reduce((a, b) => (b.year < a.year ? b : a));
const recent = dated.filter((x) => x.year >= 2020).length;

// 05 每天听多少：一列一天，点数太多时一个点代表几次
const dailyPeak = Math.max(1, ...data.daily.map((d) => d.count));
const unit = Math.max(1, Math.ceil(dailyPeak / 24));
const dailyCols = data.daily.map((d, i) => {
  const [, m, day] = d.date.split('-').map(Number);
  return { ...d, m, day, dots: Math.ceil(d.count / unit), showMonth: i === 0 || day === 1 };
});
const days = data.daily.length;
const ready = days >= MIN_DAYS;
const trendReady = data.trend.dates.length >= MIN_DAYS;

// 06 星期 × 小时
const WEEKDAYS = ['一', '二', '三', '四', '五', '六', '日'];
const SHADES = ['·', '░', '▒', '▓', '█'];
const weekPeak = Math.max(1, ...data.week.flat());
const shade = (n) => SHADES[n ? Math.ceil((n / weekPeak) * 4) : 0];
const hourTotals = Array.from({ length: 24 }, (_, h) => data.week.reduce((s, row) => s + row[h], 0));
const peakHour = hourTotals.indexOf(Math.max(...hourTotals));

// 07 实际播放最多：和 Spotify 短期榜的名次对照
const shortRank = new Map(top.artists.short_term.map((a) => [a.id, a.rank]));
const playsPeak = Math.max(1, ...data.artist_plays.map((a) => a.count));
const PLAY_BAR = 24;

// 08 名次走势：x 为日期，y 为短期榜名次（1 在上）
const TRH = 240;
const trendMax = 25;
const trendX = (i) => (data.trend.dates.length > 1 ? (i / (data.trend.dates.length - 1)) * 560 : 0);
const trendY = (r) => ((r - 1) / (trendMax - 1)) * (TRH - 20) + 10;
const trendLines = data.trend.artists.map((a) => {
  let d = '';
  let pen = false;
  a.ranks.forEach((r, i) => {
    if (r === null || r > trendMax) {
      pen = false;
      return;
    }
    d += `${pen ? 'L' : 'M'}${trendX(i).toFixed(1)} ${trendY(r).toFixed(1)} `;
    pen = true;
  });
  const lastRank = a.ranks.at(-1);
  return { ...a, d: d.trim(), y: trendY(lastRank ?? trendMax), lastRank };
});
// 右侧名字：名次相同或相近时往下错开，至少隔 12px
[...trendLines].sort((a, b) => a.y - b.y).forEach((a, i, arr) => {
  if (i > 0) a.y = Math.max(a.y, arr[i - 1].y + 12);
});

const pending = (n) => `── 记录中 · 第 ${Math.min(n, MIN_DAYS)} / ${MIN_DAYS} 天 ──`;
---

<Article
  title="Yishan ⨯ Spotify"
  docTitle="Yishan ⨯ Spotify"
  kicker="LISTEN — 在听"
  date={data.generated_at}
  description="我在 Spotify 上的收听记录：艺人名次的变化、歌曲的更替、唱片从哪里来、每天听多少。"
>
  <div class="ls-intro">
    <div class="fig" data-fig="turntable"></div>
    <p>我的 Spotify 收听记录</p>
    <p class="mono ls-stats">
      <span><b>{data.plays}</b> 次播放</span>
      <span><b>{data.tracks}</b> 首</span>
      <span><b>{data.artists}</b> 位艺人</span>
      <span>{dot(data.since)} 开始记录</span>
    </p>
  </div>

  <section class="ls-sec" aria-labelledby="ls-01">
    <h2 class="ls-h" id="ls-01"><span class="index-no">01</span> 艺人名次变化</h2>
    <p class="ls-sub">Spotify 按三个时间段给出最常听的艺人。左边是约一年，右边是最近四周；同一位艺人在相邻两列之间连线。</p>
    <div class="ls-scroll ls-fig">
      <div class="bump" style={`--rows: ${ROWS}; --row: ${ROW_H}px`}>
        {TERMS.map((t) => (
          <p class="mono bump-head">{t.label} <span>· {t.span}</span></p>
        ))}
        {bumpCols.map((col, i) => (
          <>
            <ol class={`bump-col bump-col-${i}`}>
              {col.map((a) => (
                <li class:list={['bump-row', { all: a.all }]} data-a={a.id}>
                  <span class="mono bump-rank">{pad(a.rank)}</span>
                  <span class="bump-name" title={a.name}>{a.name}</span>
                  {a.fresh && <span class="mono bump-new" title="中期和长期榜里都没有">新</span>}
                </li>
              ))}
            </ol>
            {i < 2 && (
              <svg class="bump-links" viewBox={`0 0 56 ${ROWS * ROW_H}`} aria-hidden="true">
                {bumpLinks[i].map((l) => (
                  <path class:list={['bump-link', { all: l.all }]} data-a={l.id} d={l.d} />
                ))}
              </svg>
            )}
          </>
        ))}
      </div>
    </div>
    <p class="mono ls-cap">
      三个时段都在榜的 {stayed.length} 位（实线）：{list(stayed.map((a) => a.name))}
    </p>
  </section>

  <section class="ls-sec" aria-labelledby="ls-02">
    <h2 class="ls-h" id="ls-02"><span class="index-no">02</span> 流派</h2>
    <p class="ls-sub">
      同样三个时间段，每位艺人按 MusicBrainz 上大家投票的流派标签归到大类，一位艺人可以分在几类里。条越长，这一类在那个时段的艺人里占得越多。
    </p>
    {genres ? (
      <>
        <div class="ls-scroll ls-fig">
          <div class="mono genre" role="table" aria-label="三个时段艺人的流派占比">
            <span role="columnheader"></span>
            {TERMS.map((t) => <span class="genre-head" role="columnheader">{t.label}</span>)}
            {genreRows.map((f) => (
              <>
                <span class="genre-label" role="rowheader" title={f.examples.length ? `比如 ${f.examples.join('、')}` : undefined}>
                  {f.label}
                </span>
                {f.share.map((v) => (
                  <span class="genre-cell" role="cell">
                    <span class="genre-bar" aria-hidden="true">{genreBar(v)}</span>
                    <span class="genre-pct">{v ? `${Math.round(v * 100)}%` : ''}</span>
                  </span>
                ))}
              </>
            ))}
          </div>
        </div>
        <p class="mono ls-cap">
          {rising && rising.delta > 0 && points(rising.delta) > 0 && `从一年到最近四周，${rising.label}多了 ${points(rising.delta)} 个百分点`}{falling && falling.delta < 0 && points(falling.delta) > 0 && `，${falling.label}少了 ${points(falling.delta)} 个`}{rising && rising.delta > 0 && points(rising.delta) > 0 ? '。' : ''}有流派标签的艺人：{TERMS.map((t) => `${t.label} ${genres.terms[t.key].covered}/${genres.terms[t.key].total}`).join(' · ')}
        </p>
      </>
    ) : (
      <p class="mono ls-pending">── 流派数据还没有查到 ──</p>
    )}
  </section>

  <section class="ls-sec" aria-labelledby="ls-03">
    <h2 class="ls-h" id="ls-03"><span class="index-no">03</span> 唱片登记地</h2>
    <p class="ls-sub">每首歌都有一个国际标准录音代码（ISRC），前两位是唱片登记的国家或地区。三个时段的歌合在一起，共 {ccTotal} 首。</p>
    <ul class="mono cc ls-fig">
      {ccRows.map((r) => (
        <li class="cc-row">
          <span class="cc-code">{r.cc}</span>
          <span class="cc-label">{r.label}</span>
          <span class="cc-bar" aria-hidden="true">{'█'.repeat(Math.max(1, Math.round((r.n / ccPeak) * CC_BAR)))}</span>
          <span class="cc-n">{r.n}<span class="cc-pct"> · {pct(r.n, ccTotal)}%</span></span>
        </li>
      ))}
    </ul>
    <p class="mono ls-cap">登记地不等于艺人国籍：常常是唱片公司或发行商所在地。Q 开头的代码是美国分配给独立发行平台的。</p>
  </section>

  <section class="ls-sec" aria-labelledby="ls-04">
    <h2 class="ls-h" id="ls-04"><span class="index-no">04</span> 发行年代</h2>
    <p class="ls-sub">同一批歌，按发行年份叠起来，一个点一首。</p>
    <div class="ls-scroll ls-fig">
      <svg class="years" viewBox={`0 0 ${TW} ${YH}`} role="img" aria-label={`${dated.length} 首歌的发行年份，${recent} 首发行于 2020 年以后`}>
        <line class="years-axis" x1="0" x2={TW} y1={yBase} y2={yBase} />
        {decades.map((d) => (
          <>
            <line class="years-tick" x1={(d - y0) * YCOL} x2={(d - y0) * YCOL} y1={yBase} y2={yBase + 5} />
            <text class="years-label" x={(d - y0) * YCOL + 3} y={yBase + 19}>{d}</text>
          </>
        ))}
        {yDots.map((p) => <circle class="years-dot" cx={p.cx.toFixed(1)} cy={p.cy.toFixed(1)} r="2.1" />)}
        <circle class="years-dot oldest" cx={((oldest.year - y0 + 0.5) * YCOL).toFixed(1)} cy={yBase - 4} r="2.1" />
        <text class="years-note" x={(oldest.year - y0 + 0.5) * YCOL + 8} y={yBase - 12}>
          {oldest.year} · {oldest.name} — {oldest.artists[0]}
        </text>
      </svg>
    </div>
    <p class="mono ls-cap">{dated.length} 首里 {recent} 首（{pct(recent, dated.length)}%）发行于 2020 年以后；红点是最早的一首</p>
  </section>

  <section class="ls-sec" aria-labelledby="ls-05">
    <h2 class="ls-h" id="ls-05"><span class="index-no">05</span> 每天听多少</h2>
    <p class="ls-sub">从开始记录那天起，一列一天。</p>
    <figure class="density ls-fig" aria-label={`每天的播放次数：${dot(data.since)} — ${dot(data.until)}`}>
      <div class="density-cols" style={`--peak: ${Math.ceil(dailyPeak / unit)}`}>
        {dailyCols.map((d) => (
          <span class="mono density-col" title={`${dot(d.date)} · ${d.count} 次`}>
            <span class="density-dots" aria-hidden="true">
              {d.dots ? Array.from({ length: d.dots }, () => <i>•</i>) : <i class="empty">·</i>}
            </span>
            <span class="density-m">{d.day}</span>
            {d.showMonth && <span class="density-y">{d.m} 月</span>}
          </span>
        ))}
      </div>
      <figcaption class="mono ls-cap">
        {unit > 1 ? `每个点约 ${unit} 次 · ` : '每个点一次 · '}{data.sources.playlist ?? 0} 次来自歌单，{data.sources.direct ?? 0} 次直接点播
      </figcaption>
    </figure>
  </section>

  <section class="ls-sec" aria-labelledby="ls-06">
    <h2 class="ls-h" id="ls-06"><span class="index-no">06</span> 一周里的什么时候</h2>
    <p class="ls-sub">星期 × 24 小时，格子越深听得越多。</p>
    {ready ? (
      <>
        <div class="ls-scroll ls-fig">
          <div class="mono week" role="img" aria-label={`一周里各时段的播放分布，最常在 ${peakHour} 点听`}>
            <span></span>
            {Array.from({ length: 24 }, (_, h) => <span class="week-h">{h % 6 === 0 ? h : ''}</span>)}
            {data.week.map((row, d) => (
              <>
                <span class="week-d">{WEEKDAYS[d]}</span>
                {row.map((n, h) => <span class="week-c" title={`周${WEEKDAYS[d]} ${h} 点 · ${n} 次`}>{shade(n)}</span>)}
              </>
            ))}
          </div>
        </div>
        <p class="mono ls-cap">最常在 {peakHour} 点听 · {SHADES.join(' ')} 由少到多</p>
      </>
    ) : (
      <p class="mono ls-pending">{pending(days)}</p>
    )}
  </section>

  <section class="ls-sec" aria-labelledby="ls-07">
    <h2 class="ls-h" id="ls-07"><span class="index-no">07</span> 实际放得最多</h2>
    <p class="ls-sub">按这份记录数播放次数，和 Spotify 短期榜的名次对照。</p>
    {ready ? (
      <>
        <ol class="mono plays ls-fig">
          {data.artist_plays.map((a) => (
            <li class="plays-row">
              <span class="plays-name" title={a.name}>{a.name}</span>
              <span class="plays-bar" aria-hidden="true">{'▇'.repeat(Math.max(1, Math.round((a.count / playsPeak) * PLAY_BAR)))}</span>
              <span class="plays-n">{a.count}</span>
              <span class="plays-rank">{shortRank.has(a.id) ? `榜 ${pad(shortRank.get(a.id))}` : '榜 —'}</span>
            </li>
          ))}
        </ol>
        <p class="mono ls-cap">合作曲目给每位署名艺人各记一次</p>
      </>
    ) : (
      <p class="mono ls-pending">{pending(days)}</p>
    )}
  </section>

  <section class="ls-sec" aria-labelledby="ls-08">
    <h2 class="ls-h" id="ls-08"><span class="index-no">08</span> 名次走势</h2>
    <p class="ls-sub">每天记一次短期榜，看现在前十的艺人是怎么上来的。</p>
    {trendReady ? (
      <>
        <div class="ls-scroll ls-fig">
          <svg class="trend" viewBox={`-24 0 720 ${Math.max(TRH, ...trendLines.map((a) => a.y + 10))}`} role="img" aria-label="短期榜前十位艺人的名次走势">
            {[1, 5, 10, 15, 20, 25].map((r) => (
              <>
                <line class="trend-grid" x1="0" x2="560" y1={trendY(r)} y2={trendY(r)} />
                <text class="trend-axis" x="-6" y={trendY(r) + 4}>{r}</text>
              </>
            ))}
            {trendLines.map((a) => (
              <g class="trend-line" data-a={a.id}>
                <path d={a.d} />
                <text x="572" y={a.y + 4}>{a.lastRank ? pad(a.lastRank) : '—'} {a.name}</text>
              </g>
            ))}
          </svg>
        </div>
        <p class="mono ls-cap">{dot(data.trend.dates[0])} — {dot(data.trend.dates.at(-1))} · 共 {data.trend.dates.length} 天</p>
      </>
    ) : (
      <p class="mono ls-pending">{pending(data.trend.dates.length)}</p>
    )}
  </section>
</Article>

<style>
  .ls-intro {
    margin-bottom: 64px;
  }
  .ls-intro p {
    color: var(--ink-2);
  }
  :global(.prose) .ls-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 20px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .ls-stats b {
    font-weight: 500;
    color: var(--ink);
  }

  .ls-sec + .ls-sec {
    margin-top: 72px;
  }
  :global(.prose) h2.ls-h {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .ls-h .index-no {
    margin-right: 0.6ch;
  }
  :global(.prose) .ls-sub {
    font-size: 14px;
    color: var(--ink-2);
    margin-bottom: 24px;
  }
  :global(.prose) .ls-cap {
    margin: 18px 0 0;
    font-size: 12px;
    line-height: 1.8;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }
  :global(.prose) .ls-pending {
    margin: 0;
    padding: 28px 0;
    text-align: center;
    font-size: 12px;
    color: var(--ink-3);
    border-top: 1px dotted var(--hairline-strong);
    border-bottom: 1px dotted var(--hairline-strong);
  }
  /* 图比手机屏宽时横向滚动，不把字缩到看不清 */
  .ls-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .ls-scroll > :global(*) {
    min-width: 600px;
  }

  /* 01 名次变化：三列名字是文字，列之间的连线是 svg */
  .bump {
    display: grid;
    grid-template-columns: 1fr 56px 1fr 56px 1fr;
    font-size: 13px;
  }
  :global(.prose) .bump-head {
    grid-row: 1;
    margin: 0 0 10px;
    font-size: 12px;
    color: var(--ink-2);
  }
  .bump-head:nth-child(1) { grid-column: 1; }
  .bump-head:nth-child(2) { grid-column: 3; }
  .bump-head:nth-child(3) { grid-column: 5; }
  .bump-head span {
    color: var(--ink-3);
  }
  :global(.prose) .bump-col {
    grid-row: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  :global(.prose) .bump-row {
    display: flex;
    align-items: center;
    gap: 0.8ch;
    height: var(--row);
    margin: 0;
    line-height: var(--row);
    color: var(--ink-3);
    transition: color 0.25s ease, opacity 0.25s ease;
  }
  /* 前两列名字后面用点线引到连线起点 */
  .bump-col-0 .bump-row::after,
  .bump-col-1 .bump-row::after {
    content: '';
    flex: 1 0 8px;
    align-self: center;
    border-bottom: 1px dotted var(--hairline);
    margin-left: 4px;
  }
  .bump-row.all {
    color: var(--ink);
  }
  .bump-rank {
    font-size: 11px;
    letter-spacing: 0;
    color: var(--ink-3);
  }
  .bump-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bump-new {
    font-size: 10px;
    color: var(--vermillion);
    letter-spacing: 0;
  }
  .bump-links {
    grid-row: 2;
    width: 56px;
    height: calc(var(--rows) * var(--row));
    overflow: visible;
  }
  .bump-link {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    transition: stroke 0.25s ease, opacity 0.25s ease;
  }
  .bump-link.all {
    stroke: var(--ink-2);
    stroke-dasharray: none;
  }
  .bump.hovering .bump-row:not(.on),
  .bump.hovering .bump-link:not(.on) {
    opacity: 0.25;
  }
  .bump .bump-row.on {
    color: var(--vermillion);
  }
  .bump .bump-link.on {
    stroke: var(--vermillion);
    stroke-dasharray: none;
  }

  .years,
  .trend {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--mono);
  }

  /* 02 流派：三列 ASCII 横条 */
  .genre {
    display: grid;
    grid-template-columns: 9.5em repeat(3, 1fr);
    gap: 4px 2ch;
    font-size: 12px;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .genre-head {
    color: var(--ink-2);
    margin-bottom: 4px;
  }
  .genre-label {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap;
  }
  .genre-label[title] {
    cursor: help;
  }
  .genre-cell {
    display: flex;
    gap: 1ch;
    min-width: 0;
    white-space: nowrap;
  }
  .genre-bar {
    color: var(--ink-3);
    letter-spacing: 0;
  }
  /* 网格每行 4 格，第 4 格是短期：最近的一列颜色深一些 */
  .genre-cell:nth-child(4n) .genre-bar {
    color: var(--ink-2);
  }
  .genre-pct {
    color: var(--ink-3);
  }

  /* 03 唱片登记地：ASCII 横条 */
  :global(.prose) .cc {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 12px;
  }
  :global(.prose) .cc-row {
    display: grid;
    grid-template-columns: 3ch 9em 1fr 10ch;
    gap: 1.5ch;
    align-items: baseline;
    margin: 0;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .cc-code {
    color: var(--ink);
  }
  .cc-label {
    font-family: var(--sans);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cc-bar {
    color: var(--ink-3);
    letter-spacing: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .cc-row:first-child .cc-bar {
    color: var(--ink-2);
  }
  .cc-n {
    text-align: right;
    color: var(--ink);
  }
  .cc-pct {
    color: var(--ink-3);
  }

  /* 04 发行年代 */
  .years-axis,
  .years-tick {
    stroke: var(--hairline-strong);
  }
  .years-label {
    font-size: 11px;
    fill: var(--ink-3);
  }
  .years-dot {
    fill: var(--ink-2);
  }
  .years-dot.oldest {
    fill: var(--vermillion);
  }
  .years-note {
    font-size: 11px;
    fill: var(--vermillion);
  }

  /* 05 每天：沿用短记页的月份密度点阵 */
  .density {
    margin: 0;
  }
  .density-cols {
    display: flex;
    gap: 2px;
    padding-bottom: 22px;
    border-bottom: 1px dotted var(--hairline-strong);
    overflow-x: auto;
  }
  .density-col {
    position: relative;
    flex: 0 0 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    min-height: calc(var(--peak) * 11px + 28px);
    font-size: 12px;
    color: var(--ink-3);
  }
  .density-dots {
    display: flex;
    flex-direction: column-reverse;
    line-height: 11px;
    font-size: 16px;
    color: var(--ink-2);
  }
  .density-dots i {
    font-style: normal;
  }
  .density-dots i.empty {
    color: var(--ink-3);
  }
  .density-col:hover .density-dots {
    color: var(--vermillion);
  }
  .density-m {
    margin-top: 6px;
    font-size: 11px;
  }
  .density-y {
    position: absolute;
    bottom: -20px;
    left: 0;
    font-size: 11px;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .density .ls-cap {
    margin-top: 28px;
  }

  /* 06 星期 × 小时 */
  .week {
    display: grid;
    grid-template-columns: 2.5em repeat(24, 1fr);
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--ink-2);
    text-align: center;
  }
  .week-h {
    font-size: 10px;
    color: var(--ink-3);
    text-align: left;
  }
  .week-d {
    font-size: 12px;
    color: var(--ink-3);
    text-align: left;
  }
  .week-c:hover {
    color: var(--vermillion);
  }

  /* 07 实际播放次数 */
  :global(.prose) .plays {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 12px;
  }
  :global(.prose) .plays-row {
    display: grid;
    grid-template-columns: minmax(0, 12em) 1fr 4ch 6ch;
    gap: 1.5ch;
    align-items: baseline;
    margin: 0;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .plays-name {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .plays-bar {
    color: var(--ink-3);
    letter-spacing: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .plays-n {
    text-align: right;
    color: var(--ink);
  }
  .plays-rank {
    color: var(--ink-3);
  }

  /* 08 名次走势 */
  .trend-grid {
    stroke: var(--hairline);
  }
  .trend-axis {
    font-size: 10px;
    fill: var(--ink-3);
    text-anchor: end;
  }
  .trend-line path {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.2;
    transition: stroke 0.25s ease;
  }
  .trend-line text {
    font-size: 11px;
    fill: var(--ink-2);
  }
  .trend-line:hover path {
    stroke: var(--vermillion);
  }
  .trend-line:hover text {
    fill: var(--vermillion);
  }

  /* 唱机线稿：浮在开头说明的右侧，和首页的图形同一套线宽与配色；窄屏隐藏 */
  .fig {
    float: right;
    width: 170px;
    margin: -8px 0 12px 32px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    --fg-plate: var(--paper);
    --fg-hi: var(--ink);
    --fg-edge: color-mix(in srgb, var(--ink) 55%, transparent);
    --fg-mid: color-mix(in srgb, var(--ink) 32%, transparent);
    --fg-lo: color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .fig :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .fig :global(:is(polygon, polyline, line, circle)) {
    fill: var(--fg-plate);
    stroke: var(--fg-mid);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .fig :global(.fo) {
    stroke: var(--fg-plate);
    stroke-width: 0.6;
  }
  .fig :global(.nf) { fill: none; }
  .fig :global(.sil) { stroke: var(--fg-edge); }
  .fig :global(.lo) { stroke: var(--fg-lo); }
  .fig :global(.hi) { stroke: var(--fg-hi); }
  .fig :global(.accent) { stroke: var(--vermillion); }
  .fig :global(.fo.accent) { fill: var(--vermillion); }
  .ls-intro::after {
    content: '';
    display: block;
    clear: both;
  }

  /* 每张图进入视野后从淡、微糊里浮现，0.6 秒。只有脚本加上 .rv 才隐藏 */
  .rv .ls-fig {
    opacity: 0;
    filter: blur(3px);
    translate: 0 4px;
    transition: opacity 0.6s ease, filter 0.6s ease, translate 0.6s ease;
  }
  .rv.rv-in .ls-fig {
    opacity: 1;
    filter: none;
    translate: 0 0;
  }

  @media (max-width: 720px) {
    .fig {
      display: none;
    }
    .density-col {
      flex-basis: 14px;
    }
    .density-col .density-m {
      visibility: hidden;
    }
  }
</style>

<script>
  import { mount } from '../scripts/figures/engine.js';
  import { turntable } from '../scripts/figures/turntable.js';

  const fig = document.querySelector('.fig[data-fig="turntable"]');
  mount(fig, turntable(), { trigger: fig.closest('.ls-intro') });

  // 01 / 08：指向某位艺人时，只高亮这一个人的名字和连线
  document.querySelectorAll('.bump').forEach((bump) => {
    const set = (id) => {
      bump.classList.toggle('hovering', Boolean(id));
      bump.querySelectorAll('[data-a]').forEach((el) => el.classList.toggle('on', el.dataset.a === id));
    };
    bump.addEventListener('pointerover', (e) => set(e.target.closest('[data-a]')?.dataset.a));
    bump.addEventListener('pointerleave', () => set(null));
  });

  // 05：天数多了以后默认滚到最近的一天
  document.querySelectorAll('.density-cols').forEach((el) => (el.scrollLeft = el.scrollWidth));

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach(({ isIntersecting, target }) => {
          if (!isIntersecting) return;
          io.unobserve(target);
          target.classList.add('rv-in');
        });
      },
      { threshold: 0.15 },
    );
    document.querySelectorAll('.ls-sec').forEach((sec) => {
      sec.classList.add('rv');
      io.observe(sec);
    });
  }
</script>
